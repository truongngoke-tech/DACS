@page
@model LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập — EDUTECH AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body { background: linear-gradient(135deg, #1e3a8a, #3b82f6); min-height: 100vh; }
        .login-card { border-radius: 1rem; max-width: 420px; width: 100%; }
        .form-control { border-radius: .6rem; padding: .65rem 1rem; }
        .btn-login { border-radius: .6rem; padding: .7rem; font-weight: 600; font-size: 1rem; }
        .brand-icon { width: 56px; height: 56px; background: #1e3a8a; border-radius: 1rem; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">

    <div class="login-card card shadow-lg p-4 p-md-5">
        <!-- Brand -->
        <div class="text-center mb-4">
            <div class="brand-icon d-inline-flex align-items-center justify-content-center mb-3">
                <i class="fas fa-graduation-cap text-white fs-4"></i>
            </div>
            <h4 class="fw-bold mb-0">EDUTECH AI</h4>
            <p class="text-muted small">Đăng nhập vào tài khoản của bạn</p>
        </div>

        <!-- Validation errors -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold small">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-envelope text-muted" style="font-size:.85rem;"></i>
                    </span>
                    <input asp-for="Input.Email"
                           class="form-control border-start-0"
                           placeholder="example@email.com"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold small">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-lock text-muted" style="font-size:.85rem;"></i>
                    </span>
                    <input asp-for="Input.Password"
                           type="password"
                           class="form-control border-start-0"
                           placeholder="Nhập mật khẩu..."
                           autocomplete="current-password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-login mb-3">
                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
            </button>
        </form>

        <div class="text-center">
            <span class="text-muted small">Chưa có tài khoản?</span>
            <a asp-page="./Register" class="small fw-bold ms-1">Đăng ký ngay</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
