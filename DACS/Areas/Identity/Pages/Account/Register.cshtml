@page
@model RegisterModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký — EDUTECH AI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body { background: linear-gradient(135deg, #1e3a8a, #3b82f6); min-height: 100vh; }
        .card { border-radius: 1rem; max-width: 440px; width: 100%; }
        .form-control { border-radius: .6rem; padding: .65rem 1rem; }
        .btn { border-radius: .6rem; }
        .brand-icon { width: 56px; height: 56px; background: #1e3a8a; border-radius: 1rem; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">

    <div class="card shadow-lg p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="brand-icon d-inline-flex align-items-center justify-content-center mb-3">
                <i class="fas fa-graduation-cap text-white fs-4"></i>
            </div>
            <h4 class="fw-bold mb-0">Tạo tài khoản</h4>
            <p class="text-muted small">EDUTECH AI — Học thông minh hơn</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3"></div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold small">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-envelope text-muted" style="font-size:.85rem;"></i>
                    </span>
                    <input asp-for="Input.Email"
                           class="form-control border-start-0"
                           placeholder="example@email.com"
                           autocomplete="email" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-lock text-muted" style="font-size:.85rem;"></i>
                    </span>
                    <input asp-for="Input.Password"
                           type="password"
                           class="form-control border-start-0"
                           placeholder="Tối thiểu 6 ký tự"
                           autocomplete="new-password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold small">Xác nhận mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-lock text-muted" style="font-size:.85rem;"></i>
                    </span>
                    <input asp-for="Input.ConfirmPassword"
                           type="password"
                           class="form-control border-start-0"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3">
                <i class="fas fa-user-plus me-2"></i>Tạo tài khoản
            </button>
        </form>

        <div class="text-center">
            <span class="text-muted small">Đã có tài khoản?</span>
            <a asp-page="./Login" class="small fw-bold ms-1">Đăng nhập</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
