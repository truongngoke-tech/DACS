@model DACS.Models.DeThi

@{
    ViewData["Title"] = "Tạo đề thi mới";
}

<style>
    .create-vip {
        max-width: 1180px;
        margin: 0 auto;
        position: relative;
        padding-bottom: 36px;
    }

        .create-vip::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 14% 8%, rgba(99,102,241,.23), transparent 28%), radial-gradient(circle at 88% 12%, rgba(34,211,238,.20), transparent 30%), radial-gradient(circle at 48% 100%, rgba(236,72,153,.13), transparent 35%);
            z-index: -1;
        }

    .create-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 38px;
        color: white;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.93)), radial-gradient(circle at 20% 20%, rgba(99,102,241,.9), transparent 34%), radial-gradient(circle at 86% 25%, rgba(34,211,238,.68), transparent 36%), radial-gradient(circle at 55% 95%, rgba(236,72,153,.45), transparent 38%);
        box-shadow: 0 34px 90px rgba(15,23,42,.26);
        border: 1px solid rgba(255,255,255,.15);
    }

        .create-hero::after {
            content: "✨";
            position: absolute;
            right: 42px;
            bottom: -36px;
            font-size: 170px;
            opacity: .13;
        }

    .hero-badge {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(14px);
        color: #e0f2fe;
        font-size: .82rem;
        font-weight: 850;
    }

    .hero-title {
        margin: 18px 0 10px;
        font-size: clamp(2rem, 4vw, 4rem);
        font-weight: 950;
        line-height: .95;
        letter-spacing: -2px;
    }

        .hero-title span {
            background: linear-gradient(90deg, #a5f3fc, #c4b5fd, #f9a8d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-desc {
        max-width: 700px;
        color: #cbd5e1;
        font-size: 1.02rem;
        margin: 0;
    }

    .form-grid {
        margin-top: 28px;
    }

    .panel-vip {
        height: 100%;
        border-radius: 32px;
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        box-shadow: 0 22px 55px rgba(15,23,42,.09);
        overflow: hidden;
    }

    .panel-head {
        padding: 24px 28px;
        border-bottom: 1px solid #e2e8f0;
    }

    .panel-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 950;
    }

    .panel-sub {
        color: #64748b;
        font-size: .88rem;
        font-weight: 700;
        margin-top: 4px;
    }

    .panel-body {
        padding: 28px;
    }

    .vip-label {
        font-weight: 850;
        color: #0f172a;
        font-size: .88rem;
        margin-bottom: 8px;
    }

    .vip-input,
    .vip-select {
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: 13px 18px;
        font-weight: 700;
    }

        .vip-input:focus,
        .vip-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 .25rem rgba(99,102,241,.15);
            background: white;
        }

    .quick-add {
        display: none;
        margin-top: 12px;
        border-radius: 22px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        padding: 14px;
    }

    .btn-vip-main {
        border: 0;
        border-radius: 999px;
        padding: 13px 22px;
        color: white;
        font-weight: 900;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 16px 32px rgba(79,70,229,.25);
        transition: .22s;
    }

        .btn-vip-main:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 20px 42px rgba(79,70,229,.36);
        }

    .btn-vip-ghost {
        border-radius: 999px;
        padding: 13px 22px;
        font-weight: 850;
    }

    .excel-box {
        position: relative;
        overflow: hidden;
    }

        .excel-box::after {
            content: "XLSX";
            position: absolute;
            right: -8px;
            bottom: 8px;
            font-size: 58px;
            font-weight: 950;
            color: rgba(22,163,74,.08);
            letter-spacing: -3px;
        }

    .format-card {
        border-radius: 24px;
        background: linear-gradient(135deg, #ecfdf5, #f0fdfa);
        border: 1px solid #bbf7d0;
        padding: 18px;
        color: #166534;
        font-size: .88rem;
        font-weight: 700;
    }

    .file-upload-vip {
        border-radius: 24px;
        border: 2px dashed #cbd5e1;
        background: #f8fafc;
        padding: 20px;
        transition: .22s;
    }

        .file-upload-vip:hover {
            border-color: #22c55e;
            background: #f0fdf4;
        }

    @@media (max-width: 768px) {
        .create-hero {
            padding: 26px;
        }

        .panel-body {
            padding: 22px;
        }
    }
</style>

<div class="create-vip">
    <section class="create-hero animate__animated animate__fadeIn">
        <div style="position:relative;z-index:2;">
            <div class="hero-badge">
                <i class="fas fa-circle-plus text-info"></i>
                EDUTECH AI Exam Creator
            </div>

            <h1 class="hero-title">
                Tạo <span>đề thi mới</span>
            </h1>

            <p class="hero-desc">
                Khởi tạo đề thi chuyên nghiệp, chọn chủ đề, độ khó và nhập câu hỏi nhanh từ Excel.
            </p>
        </div>
    </section>

    <div class="row g-4 form-grid">
        <div class="col-lg-7">
            <div class="panel-vip">
                <div class="panel-head">
                    <h5 class="panel-title">
                        <i class="fas fa-pen-to-square me-2 text-primary"></i>Thông tin đề thi
                    </h5>
                    <div class="panel-sub">Thiết lập cấu hình cơ bản cho đề thi</div>
                </div>

                <div class="panel-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TenDeThi" class="form-label vip-label">Tên đề thi</label>
                            <input asp-for="TenDeThi"
                                   class="form-control vip-input"
                                   placeholder="VD: Ôn tập Mạng máy tính" />
                            <span asp-validation-for="TenDeThi" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThoiGian" class="form-label vip-label">Thời gian làm bài</label>
                                <input asp-for="ThoiGian"
                                       type="number"
                                       class="form-control vip-input"
                                       value="60"
                                       min="1" />
                                <span asp-validation-for="ThoiGian" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SoCauHoi" class="form-label vip-label">Số câu hỏi mỗi đề</label>
                                <input asp-for="SoCauHoi"
                                       type="number"
                                       class="form-control vip-input"
                                       value="40"
                                       min="1" />
                                <span asp-validation-for="SoCauHoi" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="MaChuDe" class="form-label vip-label">Chủ đề</label>

                                <div class="input-group">
                                    <select asp-for="MaChuDe"
                                            class="form-select vip-select"
                                            id="CategorySelect"
                                            asp-items="ViewBag.MaChuDe">
                                        <option value="">-- Chọn chủ đề --</option>
                                    </select>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <button class="btn btn-outline-primary rounded-end-pill px-3"
                                                type="button"
                                                onclick="toggleAddCategory()"
                                                title="Thêm chủ đề mới">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    }
                                </div>

                                <span asp-validation-for="MaChuDe" class="text-danger small"></span>

                                <div id="QuickAddCategory" class="quick-add">
                                    <div class="input-group input-group-sm">
                                        <input type="text"
                                               id="NewCategoryName"
                                               class="form-control rounded-start-pill"
                                               placeholder="Tên chủ đề mới..." />

                                        <button class="btn btn-success" type="button" onclick="saveNewCategory()">
                                            Lưu
                                        </button>

                                        <button class="btn btn-secondary rounded-end-pill"
                                                type="button"
                                                onclick="toggleAddCategory()">
                                            Hủy
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="MucDoKho" class="form-label vip-label">Độ khó</label>

                                <select asp-for="MucDoKho"
                                        class="form-select vip-select"
                                        asp-items="ViewBag.DanhSachMucDo">
                                    <option value="">-- Chọn độ khó --</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-vip-main">
                                <i class="fas fa-circle-plus me-2"></i>Tạo đề thi
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary btn-vip-ghost">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="panel-vip excel-box">
                <div class="panel-head">
                    <h5 class="panel-title">
                        <i class="fas fa-file-excel me-2 text-success"></i>Nhập câu hỏi từ Excel
                    </h5>
                    <div class="panel-sub">Import nhanh danh sách câu hỏi vào đề thi</div>
                </div>

                <div class="panel-body">
                    <div class="format-card mb-4">
                        <i class="fas fa-circle-info me-1"></i>
                        Định dạng cột:
                        <br />
                        <b>Nội dung | Đáp án A | B | C | D | Đáp án đúng | Độ khó</b>
                    </div>

                    <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label vip-label">Chọn đề thi muốn nhập câu hỏi</label>
                            <select name="maDeThi"
                                    class="form-select vip-select"
                                    asp-items="ViewBag.DanhSachDeThi"
                                    required>
                                <option value="">-- Chọn đề thi --</option>
                            </select>
                        </div>

                        <div class="file-upload-vip mb-3">
                            <label class="form-label vip-label">
                                <i class="fas fa-upload me-1 text-success"></i>File Excel
                            </label>

                            <input type="file"
                                   name="file"
                                   class="form-control"
                                   accept=".xlsx, .xls"
                                   required />

                            <div class="text-muted small mt-2">
                                Chỉ hỗ trợ file .xlsx hoặc .xls
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success rounded-pill w-100 py-2 fw-bold">
                            <i class="fas fa-file-import me-2"></i>Import câu hỏi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleAddCategory() {
            const div = document.getElementById('QuickAddCategory');
            const isHidden = div.style.display === 'none' || div.style.display === '';

            div.style.display = isHidden ? 'block' : 'none';

            if (isHidden) {
                document.getElementById('NewCategoryName').focus();
            }
        }

        function saveNewCategory() {
            const nameInput = document.getElementById('NewCategoryName');
            const name = nameInput.value.trim();

            if (!name) {
                alert("Vui lòng nhập tên chủ đề!");
                return;
            }

            $.ajax({
                url: '/Exam/AddCategory',
                type: 'POST',
                data: { name: name },
                success: function (res) {
                    if (res.success) {
                        const select = document.getElementById('CategorySelect');
                        const option = new Option(res.name, res.id);

                        select.add(option);
                        select.value = res.id;

                        nameInput.value = '';
                        toggleAddCategory();

                        alert("Thành công: Đã thêm chủ đề '" + res.name + "'");
                    } else {
                        alert("Lỗi: " + res.message);
                    }
                },
                error: function () {
                    alert("Không thể kết nối với hệ thống. Kiểm tra quyền Admin của bạn.");
                }
            });
        }
    </script>
}