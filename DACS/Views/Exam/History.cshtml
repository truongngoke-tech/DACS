@using DACS.Models
@using System.Text.Json
@model IEnumerable<KetQuaThi>

@{
    ViewData["Title"] = "Nhật ký học tập";

    string GetSafeString(Dictionary<string, JsonElement> dict, string key)
    {
        if (dict.TryGetValue(key, out var element) && element.ValueKind != JsonValueKind.Null)
        {
            return element.ValueKind == JsonValueKind.String ? element.GetString() ?? "" : element.ToString();
        }

        return "";
    }

    var results = Model?.ToList() ?? new List<KetQuaThi>();
    int tongLuotLam = results.Count;
    double diemTrungBinh = results.Any() ? results.Average(x => x.TongDiem) : 0;
    double diemCaoNhat = results.Any() ? results.Max(x => x.TongDiem) : 0;
    int tongCauDung = results.Sum(x => x.SoCauDung);
}

<style>
    .history-vip {
        position: relative;
        padding-bottom: 36px;
    }

        .history-vip::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 14% 8%, rgba(99,102,241,.23), transparent 28%), radial-gradient(circle at 88% 12%, rgba(34,211,238,.20), transparent 30%), radial-gradient(circle at 48% 100%, rgba(236,72,153,.13), transparent 35%);
            z-index: -1;
        }

    .history-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 38px;
        color: white;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.93)), radial-gradient(circle at 20% 20%, rgba(99,102,241,.9), transparent 34%), radial-gradient(circle at 86% 25%, rgba(34,211,238,.68), transparent 36%), radial-gradient(circle at 55% 95%, rgba(236,72,153,.45), transparent 38%);
        box-shadow: 0 34px 90px rgba(15,23,42,.26);
        border: 1px solid rgba(255,255,255,.15);
    }

        .history-hero::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,.18), transparent);
            transform: translateX(-100%);
            animation: heroShine 5.5s infinite;
        }

    @@keyframes heroShine {
        0% {
            transform: translateX(-100%);
        }

        45%, 100% {
            transform: translateX(100%);
        }
    }

    .history-hero::after {
        content: "📈";
        position: absolute;
        right: 42px;
        bottom: -36px;
        font-size: 170px;
        opacity: .13;
        filter: drop-shadow(0 20px 25px rgba(0,0,0,.35));
    }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 28px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(14px);
        color: #e0f2fe;
        font-size: .82rem;
        font-weight: 850;
    }

    .hero-title {
        margin: 18px 0 10px;
        font-size: clamp(2rem, 4vw, 4rem);
        font-weight: 950;
        line-height: .95;
        letter-spacing: -2px;
    }

        .hero-title span {
            background: linear-gradient(90deg, #a5f3fc, #c4b5fd, #f9a8d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-desc {
        max-width: 660px;
        color: #cbd5e1;
        font-size: 1.02rem;
        margin: 0;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .hero-btn-main,
    .hero-btn-ghost {
        border-radius: 999px;
        padding: 13px 20px;
        font-weight: 900;
        text-decoration: none;
        transition: .22s;
    }

    .hero-btn-main {
        color: #0f172a;
        background: linear-gradient(135deg, #ffffff, #dbeafe);
        box-shadow: 0 16px 34px rgba(255,255,255,.16);
    }

        .hero-btn-main:hover {
            color: #4338ca;
            transform: translateY(-3px);
        }

    .hero-btn-ghost {
        color: white;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.18);
    }

        .hero-btn-ghost:hover {
            color: white;
            background: rgba(255,255,255,.16);
            transform: translateY(-3px);
        }

    .hero-score {
        min-width: 190px;
        border-radius: 30px;
        padding: 26px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(16px);
        text-align: center;
    }

        .hero-score .num {
            font-size: 3rem;
            font-weight: 950;
            line-height: 1;
        }

    .stats-grid {
        margin-top: -52px;
        position: relative;
        z-index: 5;
    }

    .stat-vip {
        position: relative;
        overflow: hidden;
        height: 100%;
        border-radius: 28px;
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        padding: 24px;
        box-shadow: 0 22px 55px rgba(15,23,42,.10);
        transition: .25s;
    }

        .stat-vip:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 76px rgba(15,23,42,.16);
        }

        .stat-vip::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -58px;
            top: -58px;
            border-radius: 50%;
            background: var(--glow);
            opacity: .17;
        }

    .stat-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 24px;
        background: var(--grad);
        box-shadow: 0 15px 30px var(--shadow);
        margin-bottom: 15px;
    }

    .stat-num {
        font-size: 2.2rem;
        font-weight: 950;
        line-height: 1;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .stat-label {
        color: #64748b;
        font-size: .88rem;
        font-weight: 700;
        margin-top: 8px;
    }

    .history-toolbar {
        margin-top: 28px;
        padding: 18px;
        border-radius: 28px;
        background: rgba(255,255,255,.88);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
        }

        .search-box input {
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            padding: 14px 18px 14px 46px;
            font-weight: 750;
            background: #f8fafc;
        }

            .search-box input:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 .25rem rgba(99,102,241,.15);
            }

    .history-list {
        margin-top: 26px;
    }

    .result-card {
        position: relative;
        overflow: hidden;
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        box-shadow: 0 22px 55px rgba(15,23,42,.09);
        margin-bottom: 18px;
        transition: .25s;
    }

        .result-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 32px 78px rgba(15,23,42,.15);
        }

        .result-card::before {
            content: "";
            position: absolute;
            inset: 0;
            width: 7px;
            background: var(--statusColor);
        }

    .result-head {
        position: relative;
        padding: 24px 26px;
        cursor: pointer;
    }

    .exam-avatar {
        width: 62px;
        height: 62px;
        border-radius: 22px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 26px;
        flex-shrink: 0;
        background: var(--statusColor);
        box-shadow: 0 16px 32px var(--statusShadow);
    }

    .result-title {
        font-size: 1.1rem;
        font-weight: 950;
        color: #0f172a;
        margin-bottom: 6px;
    }

    .result-date {
        color: #64748b;
        font-size: .85rem;
        font-weight: 700;
    }

    .score-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        min-width: 88px;
        padding: 10px 14px;
        font-weight: 950;
        color: white;
        background: var(--statusColor);
        box-shadow: 0 14px 28px var(--statusShadow);
    }

    .mini-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 850;
        background: #f1f5f9;
        color: #475569;
    }

    .status-label {
        font-weight: 900;
        font-size: .88rem;
    }

    .detail-area {
        border-top: 1px solid #e2e8f0;
        background: linear-gradient(180deg, #f8fafc, #ffffff);
        padding: 24px 26px;
    }

    .detail-table {
        border-collapse: separate;
        border-spacing: 0 10px;
    }

        .detail-table thead th {
            border: 0;
            color: #64748b;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            font-weight: 900;
        }

        .detail-table tbody tr {
            background: white;
            box-shadow: 0 10px 24px rgba(15,23,42,.05);
        }

        .detail-table tbody td {
            border: 0;
            padding: 14px;
            vertical-align: middle;
        }

        .detail-table tbody tr td:first-child {
            border-radius: 18px 0 0 18px;
        }

        .detail-table tbody tr td:last-child {
            border-radius: 0 18px 18px 0;
        }

    .answer-badge {
        min-width: 30px;
        height: 30px;
        border-radius: 10px;
        display: inline-grid;
        place-items: center;
        color: white;
        font-weight: 900;
        font-size: .8rem;
    }

    .wrong-summary {
        margin-top: 18px;
        padding: 18px;
        border-radius: 24px;
        background: rgba(239,68,68,.08);
        border: 1px solid rgba(239,68,68,.18);
    }

    .empty-state-vip {
        border-radius: 34px;
        padding: 58px 24px;
        text-align: center;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .empty-icon {
        width: 92px;
        height: 92px;
        margin: 0 auto 18px;
        border-radius: 32px;
        display: grid;
        place-items: center;
        font-size: 42px;
        color: white;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 18px 36px rgba(79,70,229,.24);
    }

    @@media (max-width: 992px) {
        .hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-score {
            width: 100%;
        }

        .stats-grid {
            margin-top: 22px;
        }

        .result-head .row {
            gap: 16px;
        }
    }

    @@media (max-width: 576px) {
        .history-hero {
            padding: 26px;
        }

        .result-head {
            padding: 22px;
        }

        .detail-area {
            padding: 18px;
        }
    }
</style>

<div class="history-vip">
    <section class="history-hero animate__animated animate__fadeIn">
        <div class="hero-inner">
            <div>
                <div class="hero-badge">
                    <i class="fas fa-chart-line text-info"></i>
                    EDUTECH AI Learning History
                </div>

                <h1 class="hero-title">
                    Nhật ký <span>học tập</span>
                </h1>

                <p class="hero-desc">
                    Theo dõi toàn bộ quá trình làm bài, xem lại câu đúng sai và cải thiện điểm số qua từng lần luyện tập.
                </p>

                <div class="hero-actions">
                    <a href="/Exam/Index" class="hero-btn-main">
                        <i class="fas fa-plus me-2"></i>Làm bài mới
                    </a>

                    <a href="/AI/Roadmap" class="hero-btn-ghost">
                        <i class="fas fa-route me-2"></i>Xem lộ trình AI
                    </a>
                </div>
            </div>

            <div class="hero-score">
                <div class="num">@diemTrungBinh.ToString("F1")</div>
                <div class="small fw-bold text-white-50 mt-2">Điểm trung bình</div>
            </div>
        </div>
    </section>

    <div class="row g-4 stats-grid">
        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#4f46e5,#06b6d4);--shadow:rgba(79,70,229,.28);--glow:#4f46e5;">
                <div class="stat-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div class="stat-num">@tongLuotLam</div>
                <div class="stat-label">Lượt làm bài</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#16a34a,#22c55e);--shadow:rgba(34,197,94,.28);--glow:#22c55e;">
                <div class="stat-icon">
                    <i class="fas fa-check-double"></i>
                </div>
                <div class="stat-num">@tongCauDung</div>
                <div class="stat-label">Tổng câu đúng</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#f59e0b,#f97316);--shadow:rgba(249,115,22,.28);--glow:#f59e0b;">
                <div class="stat-icon">
                    <i class="fas fa-trophy"></i>
                </div>
                <div class="stat-num">@diemCaoNhat.ToString("F1")</div>
                <div class="stat-label">Điểm cao nhất</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#db2777,#ec4899);--shadow:rgba(236,72,153,.28);--glow:#ec4899;">
                <div class="stat-icon">
                    <i class="fas fa-fire"></i>
                </div>
                <div class="stat-num">
                    @(diemTrungBinh >= 8 ? "VIP" : diemTrungBinh >= 5 ? "OK" : "Go")
                </div>
                <div class="stat-label">Phong độ học tập</div>
            </div>
        </div>
    </div>

    <div class="history-toolbar">
        <div class="row g-3 align-items-center">
            <div class="col-lg-7">
                <div class="search-box">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="text" id="searchHistory" class="form-control" placeholder="Tìm theo tên đề thi..." />
                </div>
            </div>

            <div class="col-lg-5 text-lg-end">
                <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 fw-bold">
                    <i class="fas fa-clock-rotate-left me-1"></i>
                    @tongLuotLam lịch sử
                </span>
            </div>
        </div>
    </div>

    <div class="history-list" id="historyList">
        @if (!results.Any())
        {
            <div class="empty-state-vip">
                <div class="empty-icon">
                    <i class="fas fa-folder-open"></i>
                </div>

                <h4 class="fw-black text-dark">Bạn chưa có lịch sử làm bài nào</h4>

                <p class="text-muted mb-4">
                    Hãy bắt đầu làm bài để hệ thống ghi nhận kết quả học tập.
                </p>

                <a href="/Exam/Index" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="fas fa-play me-2"></i>Bắt đầu làm bài
                </a>
            </div>
        }
        else
        {
            @foreach (var item in results)
            {
                List<Dictionary<string, JsonElement>>? chiTiet = null;

                if (!string.IsNullOrEmpty(item.ChiTietJson))
                {
                    try
                    {
                        chiTiet = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(item.ChiTietJson);
                    }
                    catch { }
                }

                var statusText = item.TongDiem >= 8 ? "Xuất sắc" : item.TongDiem >= 5 ? "Đạt" : "Cần cố gắng";
                var statusIcon = item.TongDiem >= 8 ? "fas fa-medal" : item.TongDiem >= 5 ? "fas fa-circle-check" : "fas fa-triangle-exclamation";
                var statusColor = item.TongDiem >= 8
                    ? "linear-gradient(135deg,#16a34a,#22c55e)"
                    : item.TongDiem >= 5
                        ? "linear-gradient(135deg,#4f46e5,#06b6d4)"
                        : "linear-gradient(135deg,#dc2626,#f97316)";
                var statusShadow = item.TongDiem >= 8
                    ? "rgba(34,197,94,.28)"
                    : item.TongDiem >= 5
                        ? "rgba(79,70,229,.28)"
                        : "rgba(239,68,68,.28)";

                <div class="result-card history-item"
                     style="--statusColor:@statusColor;--statusShadow:@statusShadow;">
                    <div class="result-head" onclick="toggleDetail('detail-@item.MaKetQua')">
                        <div class="row align-items-center">
                            <div class="col-lg-5">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="exam-avatar">
                                        <i class="fas fa-file-circle-check"></i>
                                    </div>

                                    <div>
                                        <div class="result-title exam-history-name">
                                            @(item.DeThi?.TenDeThi ?? "Không rõ đề thi")
                                        </div>

                                        <div class="result-date">
                                            <i class="far fa-calendar me-1"></i>
                                            @item.NgayThi.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-2">
                                <span class="mini-pill">
                                    <i class="fas fa-circle-question text-primary"></i>
                                    @item.SoCauDung / @(item.DeThi?.SoCauHoi ?? 0) đúng
                                </span>
                            </div>

                            <div class="col-lg-2">
                                <span class="score-pill">
                                    @item.TongDiem điểm
                                </span>
                            </div>

                            <div class="col-lg-2">
                                <div class="status-label"
                                     style="background:@statusColor;-webkit-background-clip:text;-webkit-text-fill-color:transparent;">
                                    <i class="@statusIcon me-1"></i>@statusText
                                </div>
                            </div>

                            <div class="col-lg-1 text-lg-end">
                                <div class="d-flex gap-2 justify-content-lg-end">
                                    <a href="/Exam/Result/@item.MaKetQua"
                                       class="btn btn-sm btn-outline-secondary rounded-pill"
                                       onclick="event.stopPropagation()">
                                        Xem
                                    </a>

                                    <form asp-action="DeleteHistory"
                                          asp-controller="Exam"
                                          asp-route-id="@item.MaKetQua"
                                          method="post"
                                          onclick="event.stopPropagation()"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa lịch sử bài làm này?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (chiTiet != null)
                    {
                        <div id="detail-@item.MaKetQua" style="display:none">
                            <div class="detail-area">
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0 small detail-table">
                                        <thead>
                                            <tr>
                                                <th style="width:40px">#</th>
                                                <th>Câu hỏi</th>
                                                <th>Đáp án bạn chọn</th>
                                                <th>Đáp án đúng</th>
                                                <th class="text-center" style="width:80px">Kết quả</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @{
                                                int stt = 1;
                                            }

                                            @foreach (var cau in chiTiet)
                                            {
                                                bool laDung = GetSafeString(cau, "LaDung")
                                                    .Equals("True", StringComparison.OrdinalIgnoreCase);

                                                string dapAnChon = GetSafeString(cau, "DapAnChon");
                                                string dapAnDung = GetSafeString(cau, "DapAnDung");
                                                string noiDungCauHoi = GetSafeString(cau, "NoiDung");

                                                string noiDungChon = GetSafeString(cau, $"PhuongAn{dapAnChon}");
                                                string noiDungDung = GetSafeString(cau, $"PhuongAn{dapAnDung}");

                                                <tr>
                                                    <td class="text-muted fw-black">@stt</td>

                                                    <td class="fw-semibold text-break">
                                                        @noiDungCauHoi
                                                    </td>

                                                    <td>
                                                        @if (string.IsNullOrEmpty(dapAnChon))
                                                        {
                                                            <span class="text-muted fst-italic small">Bỏ qua</span>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex align-items-start gap-2">
                                                                <span class="answer-badge @(laDung ? "bg-success" : "bg-danger")">
                                                                    @dapAnChon
                                                                </span>

                                                                @if (!string.IsNullOrEmpty(noiDungChon))
                                                                {
                                                                    <span class="small text-break">@noiDungChon</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="small text-muted fst-italic">(Chưa lưu nội dung)</span>
                                                                }
                                                            </div>
                                                        }
                                                    </td>

                                                    <td>
                                                        <div class="d-flex align-items-start gap-2">
                                                            <span class="answer-badge bg-success">
                                                                @dapAnDung
                                                            </span>

                                                            @if (!string.IsNullOrEmpty(noiDungDung))
                                                            {
                                                                <span class="small text-break">@noiDungDung</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="small text-muted fst-italic">(Chưa lưu nội dung)</span>
                                                            }
                                                        </div>
                                                    </td>

                                                    <td class="text-center">
                                                        @if (laDung)
                                                        {
                                                            <i class="fas fa-circle-check text-success fs-5"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-circle-xmark text-danger fs-5"></i>
                                                        }
                                                    </td>
                                                </tr>

                                                stt++;
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @{
                                    var cauSai = chiTiet
                                        .Where(c => !GetSafeString(c, "LaDung")
                                        .Equals("True", StringComparison.OrdinalIgnoreCase))
                                        .ToList();
                                }

                                @if (cauSai.Any())
                                {
                                    <div class="wrong-summary">
                                        <div class="small fw-black text-danger mb-3">
                                            <i class="fas fa-circle-exclamation me-1"></i>
                                            Cần ôn lại @cauSai.Count câu
                                        </div>

                                        @foreach (var sai in cauSai)
                                        {
                                            var dDung = GetSafeString(sai, "DapAnDung");
                                            var nDung = GetSafeString(sai, $"PhuongAn{dDung}");

                                            <div class="small text-dark mb-2">
                                                <span class="badge bg-danger me-1">Sai</span>
                                                @GetSafeString(sai, "NoiDung")
                                                <span class="text-muted ms-1">
                                                    — Đáp án đúng:
                                                    <b class="text-success">
                                                        @dDung@(string.IsNullOrEmpty(nDung) ? "" : $": {nDung}")
                                                    </b>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleDetail(id) {
            const el = document.getElementById(id);
            if (!el) return;

            const isHidden = el.style.display === 'none';
            el.style.display = isHidden ? 'block' : 'none';
        }

        document.getElementById('searchHistory')?.addEventListener('input', function () {
            const kw = this.value.toLowerCase().trim();

            document.querySelectorAll('.history-item').forEach(item => {
                const name = item.querySelector('.exam-history-name')?.textContent.toLowerCase() || '';
                item.style.display = name.includes(kw) ? '' : 'none';
            });
        });
    </script>
}