@model IEnumerable<CauHoiSai>

@{
    ViewData["Title"] = "Sổ tay câu sai";

    var nhomTheoDE = Model
        .GroupBy(c => c.CauHoi?.DeThi?.TenDeThi ?? "Không rõ")
        .ToList();

    int totalWrong = Model.Count();
    int totalExam = nhomTheoDE.Count();
    int totalRetry = Model.Sum(x => x.LanSai);
}

<style>
    .wrongbook-vip {
        position: relative;
        padding-bottom: 36px;
    }

        .wrongbook-vip::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 14% 8%, rgba(99,102,241,.23), transparent 28%), radial-gradient(circle at 88% 12%, rgba(34,211,238,.20), transparent 30%), radial-gradient(circle at 48% 100%, rgba(236,72,153,.13), transparent 35%);
            z-index: -1;
        }

    .wrong-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 38px;
        color: white;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.93)), radial-gradient(circle at 20% 20%, rgba(239,68,68,.7), transparent 34%), radial-gradient(circle at 86% 25%, rgba(245,158,11,.55), transparent 36%), radial-gradient(circle at 55% 95%, rgba(236,72,153,.38), transparent 38%);
        box-shadow: 0 34px 90px rgba(15,23,42,.26);
        border: 1px solid rgba(255,255,255,.15);
    }

        .wrong-hero::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,.18), transparent);
            transform: translateX(-100%);
            animation: heroShine 5.5s infinite;
        }

    @@keyframes heroShine {
        0% {
            transform: translateX(-100%);
        }

        45%, 100% {
            transform: translateX(100%);
        }
    }

    .wrong-hero::after {
        content: "🧠";
        position: absolute;
        right: 40px;
        bottom: -30px;
        font-size: 170px;
        opacity: .12;
    }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 28px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(14px);
        color: #e0f2fe;
        font-size: .82rem;
        font-weight: 850;
    }

    .hero-title {
        margin: 18px 0 10px;
        font-size: clamp(2rem, 4vw, 4rem);
        font-weight: 950;
        line-height: .95;
        letter-spacing: -2px;
    }

        .hero-title span {
            background: linear-gradient(90deg, #fca5a5, #fde68a, #f9a8d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-desc {
        max-width: 660px;
        color: #cbd5e1;
        font-size: 1.02rem;
        margin: 0;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .hero-btn-main,
    .hero-btn-ghost {
        border-radius: 999px;
        padding: 13px 20px;
        font-weight: 900;
        text-decoration: none;
        transition: .22s;
    }

    .hero-btn-main {
        color: #0f172a;
        background: linear-gradient(135deg, #ffffff, #dbeafe);
        box-shadow: 0 16px 34px rgba(255,255,255,.16);
    }

        .hero-btn-main:hover {
            color: #dc2626;
            transform: translateY(-3px);
        }

    .hero-btn-ghost {
        color: white;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.18);
    }

        .hero-btn-ghost:hover {
            color: white;
            background: rgba(255,255,255,.16);
            transform: translateY(-3px);
        }

    .hero-stat {
        min-width: 210px;
        border-radius: 30px;
        padding: 28px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(16px);
        text-align: center;
    }

        .hero-stat .num {
            font-size: 3.2rem;
            font-weight: 950;
            line-height: 1;
        }

    .stats-grid {
        margin-top: -52px;
        position: relative;
        z-index: 5;
    }

    .stat-vip {
        position: relative;
        overflow: hidden;
        height: 100%;
        border-radius: 28px;
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        padding: 24px;
        box-shadow: 0 22px 55px rgba(15,23,42,.10);
        transition: .25s;
    }

        .stat-vip:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 76px rgba(15,23,42,.16);
        }

    .stat-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 24px;
        background: var(--grad);
        box-shadow: 0 15px 30px var(--shadow);
        margin-bottom: 15px;
    }

    .stat-num {
        font-size: 2.2rem;
        font-weight: 950;
        line-height: 1;
        color: #0f172a;
    }

    .stat-label {
        color: #64748b;
        font-size: .88rem;
        font-weight: 700;
        margin-top: 8px;
    }

    .exam-group {
        margin-top: 28px;
        border-radius: 32px;
        overflow: hidden;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.09);
    }

    .group-head {
        padding: 22px 26px;
        background: linear-gradient(135deg, rgba(239,68,68,.08), rgba(245,158,11,.08));
        border-bottom: 1px solid #e2e8f0;
    }

    .group-title {
        font-size: 1rem;
        font-weight: 950;
        color: #dc2626;
    }

    .wrong-item {
        padding: 24px 26px;
        border-bottom: 1px solid #e2e8f0;
        transition: .22s;
    }

        .wrong-item:hover {
            background: rgba(248,250,252,.7);
        }

        .wrong-item:last-child {
            border-bottom: 0;
        }

    .question-title {
        color: #0f172a;
        font-weight: 900;
        font-size: 1rem;
    }

    .answer-card {
        border-radius: 18px;
        padding: 14px;
        height: 100%;
        transition: .2s;
        font-size: .88rem;
    }

        .answer-card:hover {
            transform: translateY(-2px);
        }

    .answer-badge {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        display: inline-grid;
        place-items: center;
        color: white;
        font-weight: 900;
        font-size: .82rem;
    }

    .wrong-meta {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 8px 12px;
        font-size: .78rem;
        font-weight: 850;
        background: #f1f5f9;
        color: #475569;
    }

    .ai-btn {
        border-radius: 999px;
        padding: 10px 16px;
        font-weight: 850;
    }

    .ai-box {
        margin-top: 18px;
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(79,70,229,.06), rgba(6,182,212,.06));
        border: 1px solid rgba(79,70,229,.12);
        padding: 18px;
    }

    .empty-state-vip {
        margin-top: 28px;
        border-radius: 34px;
        padding: 58px 24px;
        text-align: center;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .empty-icon {
        width: 92px;
        height: 92px;
        margin: 0 auto 18px;
        border-radius: 32px;
        display: grid;
        place-items: center;
        font-size: 42px;
        color: white;
        background: linear-gradient(135deg, #16a34a, #22c55e);
        box-shadow: 0 18px 36px rgba(34,197,94,.24);
    }

    @@media (max-width: 992px) {
        .hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-stat {
            width: 100%;
        }

        .stats-grid {
            margin-top: 22px;
        }
    }

    @@media (max-width: 576px) {
        .wrong-hero {
            padding: 26px;
        }

        .wrong-item {
            padding: 20px;
        }
    }
</style>

<div class="wrongbook-vip">
    <section class="wrong-hero animate__animated animate__fadeIn">
        <div class="hero-inner">
            <div>
                <div class="hero-badge">
                    <i class="fas fa-brain text-warning"></i>
                    EDUTECH AI Wrong Answer Notebook
                </div>

                <h1 class="hero-title">
                    Sổ tay <span>câu sai</span>
                </h1>

                <p class="hero-desc">
                    AI tự động ghi lại những câu bạn làm sai để giúp bạn luyện tập trọng tâm và tăng điểm nhanh hơn.
                </p>

                <div class="hero-actions">
                    <a asp-action="Index" class="hero-btn-main">
                        <i class="fas fa-play me-2"></i>Đi thi tiếp
                    </a>

                    <a href="/Exam/History" class="hero-btn-ghost">
                        <i class="fas fa-clock-rotate-left me-2"></i>Xem lịch sử
                    </a>
                </div>
            </div>

            <div class="hero-stat">
                <div class="num">@totalWrong</div>
                <div class="small fw-bold text-white-50 mt-2">Câu cần ôn</div>
            </div>
        </div>
    </section>

    <div class="row g-4 stats-grid">
        <div class="col-md-4">
            <div class="stat-vip">
                <div class="stat-icon"
                     style="--grad:linear-gradient(135deg,#dc2626,#f97316);--shadow:rgba(239,68,68,.28);">
                    <i class="fas fa-circle-xmark"></i>
                </div>

                <div class="stat-num">@totalWrong</div>
                <div class="stat-label">Câu trả lời sai</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-vip">
                <div class="stat-icon"
                     style="--grad:linear-gradient(135deg,#4f46e5,#06b6d4);--shadow:rgba(79,70,229,.28);">
                    <i class="fas fa-file-alt"></i>
                </div>

                <div class="stat-num">@totalExam</div>
                <div class="stat-label">Đề thi liên quan</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-vip">
                <div class="stat-icon"
                     style="--grad:linear-gradient(135deg,#f59e0b,#ec4899);--shadow:rgba(236,72,153,.28);">
                    <i class="fas fa-fire"></i>
                </div>

                <div class="stat-num">@totalRetry</div>
                <div class="stat-label">Tổng số lần sai</div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state-vip">
            <div class="empty-icon">
                <i class="fas fa-check"></i>
            </div>

            <h4 class="fw-black text-dark">Tuyệt vời! Bạn chưa có câu sai nào.</h4>

            <p class="text-muted mb-4">
                Hệ thống sẽ tự động lưu những câu bạn làm sai để AI giúp bạn ôn tập.
            </p>

            <a asp-action="Index" class="btn btn-success rounded-pill px-4 fw-bold">
                <i class="fas fa-play me-2"></i>Tiếp tục luyện tập
            </a>
        </div>
    }
    else
    {
        @foreach (var nhom in nhomTheoDE)
        {
            <div class="exam-group">
                <div class="group-head">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="group-title">
                            <i class="fas fa-file-lines me-2"></i>@nhom.Key
                        </div>

                        <span class="badge bg-danger rounded-pill px-3 py-2">
                            @nhom.Count() câu sai
                        </span>
                    </div>
                </div>

                @foreach (var item in nhom.OrderByDescending(x => x.LanSai))
                {
                    var cau = item.CauHoi;

                    <div class="wrong-item" id="item-@item.Id">
                        <div class="d-flex justify-content-between gap-3 align-items-start mb-3">
                            <div class="question-title">
                                @cau?.NoiDung
                            </div>

                            <form asp-action="XoaCauSai"
                                  method="post"
                                  class="flex-shrink-0">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger rounded-pill btn-sm"
                                        onclick="return confirm('Xóa câu này khỏi sổ tay?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>

                        <div class="row g-3 mb-3">
                            @foreach (var opt in new[] {
                                ("A", cau?.PhuongAnA),
                                ("B", cau?.PhuongAnB),
                                ("C", cau?.PhuongAnC),
                                ("D", cau?.PhuongAnD)
                            })
                            {
                                if (!string.IsNullOrEmpty(opt.Item2))
                                {
                                    bool laDung = opt.Item1 == cau?.DapAnDung;
                                    bool laSai = opt.Item1 == item.DapAnDaChon && !laDung;

                                    <div class="col-md-6">
                                        <div class="answer-card
                                            @(laDung ? "bg-success bg-opacity-10 border border-success"
                                             : laSai ? "bg-danger bg-opacity-10 border border-danger"
                                             : "bg-light border")">

                                            <div class="d-flex gap-2 align-items-start">
                                                <span class="answer-badge @(laDung ? "bg-success" : laSai ? "bg-danger" : "bg-secondary")">
                                                    @opt.Item1
                                                </span>

                                                <div class="small fw-semibold">
                                                    @opt.Item2

                                                    @if (laDung)
                                                    {
                                                        <i class="fas fa-circle-check text-success ms-1"></i>
                                                    }

                                                    @if (laSai)
                                                    {
                                                        <i class="fas fa-circle-xmark text-danger ms-1"></i>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="wrong-meta">
                            <span class="meta-pill">
                                <i class="fas fa-triangle-exclamation text-danger"></i>
                                Sai @item.LanSai lần
                            </span>

                            <span class="meta-pill">
                                <i class="far fa-calendar text-primary"></i>
                                @item.LanCuoiSai.ToString("dd/MM/yyyy")
                            </span>

                            <button class="btn btn-outline-info ai-btn ms-auto"
                                    onclick="giaiThich(@cau?.MaCauHoi, '@item.DapAnDaChon', '@cau?.DapAnDung', this)">
                                <i class="fas fa-robot me-1"></i>AI giải thích
                            </button>
                        </div>

                        <div class="ai-explain-box ai-box" style="display:none"></div>
                    </div>
                }
            </div>
        }
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()

    <script>
        async function giaiThich(maCauHoi, dapAnChon, dapAnDung, btn) {

            const box = btn.closest('.wrong-item').querySelector('.ai-explain-box');

            btn.disabled = true;

            btn.innerHTML =
                '<i class="fas fa-spinner fa-spin me-1"></i>AI đang phân tích...';

            box.style.display = 'block';

            box.innerHTML =
                '<div class="small fw-semibold text-muted">' +
                '<i class="fas fa-robot text-info me-2"></i>' +
                'Đang kết nối AI...' +
                '</div>';

            try {

                const token =
                    document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

                const res = await fetch('/Exam/GiaiThichAI', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body:
                        'maCauHoi=' + maCauHoi +
                        '&dapAnChon=' + dapAnChon +
                        '&dapAnDung=' + dapAnDung
                });

                const data = await res.json();

                box.innerHTML =
                    '<div class="small">' +
                    '<div class="fw-black text-primary mb-2">' +
                    '<i class="fas fa-robot me-2"></i>AI Giải thích' +
                    '</div>' +
                    data.message +
                    '</div>';

            } catch (e) {

                box.innerHTML =
                    '<div class="text-danger small fw-bold">' +
                    '<i class="fas fa-circle-xmark me-1"></i>' +
                    'Không thể kết nối AI.' +
                    '</div>';
            }

            btn.disabled = false;

            btn.innerHTML =
                '<i class="fas fa-robot me-1"></i>AI giải thích';
        }
    </script>
}