@model IEnumerable<DeThiYeuThich>

@{
    ViewData["Title"] = "Đề thi đã lưu";
    var totalSaved = Model?.Count() ?? 0;
}

<style>
    .saved-vip {
        position: relative;
        padding-bottom: 36px;
    }

        .saved-vip::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 14% 8%, rgba(99,102,241,.23), transparent 28%), radial-gradient(circle at 88% 12%, rgba(34,211,238,.20), transparent 30%), radial-gradient(circle at 48% 100%, rgba(236,72,153,.13), transparent 35%);
            z-index: -1;
        }

    .saved-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 38px;
        color: white;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.93)), radial-gradient(circle at 20% 20%, rgba(99,102,241,.9), transparent 34%), radial-gradient(circle at 86% 25%, rgba(34,211,238,.68), transparent 36%), radial-gradient(circle at 55% 95%, rgba(236,72,153,.45), transparent 38%);
        box-shadow: 0 34px 90px rgba(15,23,42,.26);
        border: 1px solid rgba(255,255,255,.15);
    }

        .saved-hero::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,.18), transparent);
            transform: translateX(-100%);
            animation: heroShine 5.5s infinite;
        }

    @@keyframes heroShine {
        0% {
            transform: translateX(-100%);
        }

        45%, 100% {
            transform: translateX(100%);
        }
    }

    .saved-hero::after {
        content: "🔖";
        position: absolute;
        right: 42px;
        bottom: -36px;
        font-size: 170px;
        opacity: .13;
        filter: drop-shadow(0 20px 25px rgba(0,0,0,.35));
    }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 28px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(14px);
        color: #e0f2fe;
        font-size: .82rem;
        font-weight: 850;
    }

    .hero-title {
        margin: 18px 0 10px;
        font-size: clamp(2rem, 4vw, 4rem);
        font-weight: 950;
        line-height: .95;
        letter-spacing: -2px;
    }

        .hero-title span {
            background: linear-gradient(90deg, #a5f3fc, #c4b5fd, #f9a8d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-desc {
        max-width: 660px;
        color: #cbd5e1;
        font-size: 1.02rem;
        margin: 0;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .hero-btn-main,
    .hero-btn-ghost {
        border-radius: 999px;
        padding: 13px 20px;
        font-weight: 900;
        text-decoration: none;
        transition: .22s;
    }

    .hero-btn-main {
        color: #0f172a;
        background: linear-gradient(135deg, #ffffff, #dbeafe);
        box-shadow: 0 16px 34px rgba(255,255,255,.16);
    }

        .hero-btn-main:hover {
            color: #4338ca;
            transform: translateY(-3px);
        }

    .hero-btn-ghost {
        color: white;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.18);
    }

        .hero-btn-ghost:hover {
            color: white;
            background: rgba(255,255,255,.16);
            transform: translateY(-3px);
        }

    .hero-stat {
        min-width: 190px;
        border-radius: 30px;
        padding: 26px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(16px);
        text-align: center;
    }

        .hero-stat .num {
            font-size: 3.1rem;
            font-weight: 950;
            line-height: 1;
        }

    .toolbar-vip {
        margin-top: 24px;
        padding: 18px;
        border-radius: 28px;
        background: rgba(255,255,255,.88);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
        }

        .search-box input {
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            padding: 14px 18px 14px 46px;
            font-weight: 750;
            background: #f8fafc;
        }

            .search-box input:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 .25rem rgba(99,102,241,.15);
            }

    .saved-grid {
        margin-top: 26px;
    }

    .saved-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        box-shadow: 0 22px 55px rgba(15,23,42,.09);
        transition: .25s;
    }

        .saved-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 34px 85px rgba(15,23,42,.16);
        }

        .saved-card::before {
            content: "";
            position: absolute;
            inset: 0;
            height: 7px;
            background: linear-gradient(90deg, #f59e0b, #ec4899, #6366f1);
        }

    .saved-card-body {
        padding: 24px;
    }

    .saved-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 18px;
    }

    .topic-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #eef2ff;
        color: #4f46e5;
        font-weight: 850;
        font-size: .78rem;
    }

    .level-badge {
        padding: 8px 12px;
        border-radius: 999px;
        font-weight: 850;
        font-size: .76rem;
    }

    .saved-icon {
        width: 62px;
        height: 62px;
        border-radius: 22px;
        display: grid;
        place-items: center;
        font-size: 27px;
        color: white;
        background: linear-gradient(135deg, #f59e0b, #ec4899);
        box-shadow: 0 18px 35px rgba(236,72,153,.25);
        margin-bottom: 18px;
    }

    .saved-title {
        color: #0f172a;
        font-size: 1.16rem;
        font-weight: 950;
        min-height: 58px;
        letter-spacing: -.2px;
    }

    .meta-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }

    .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .78rem;
        font-weight: 800;
        background: #f1f5f9;
        color: #475569;
    }

    .saved-footer {
        padding: 0 24px 24px;
    }

    .btn-start {
        width: 100%;
        border: 0;
        border-radius: 18px;
        padding: 13px 16px;
        color: white;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 16px 32px rgba(79,70,229,.25);
        transition: .23s;
    }

        .btn-start:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 20px 42px rgba(79,70,229,.36);
        }

    .bottom-actions {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

        .bottom-actions .btn {
            border-radius: 18px;
            padding: 10px 12px;
            font-weight: 850;
        }

    .remove-save {
        transition: .2s;
    }

        .remove-save:hover {
            background: #fff7ed;
            transform: translateY(-2px);
        }

    .empty-state-vip {
        margin-top: 26px;
        border-radius: 34px;
        padding: 58px 24px;
        text-align: center;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .empty-icon {
        width: 92px;
        height: 92px;
        margin: 0 auto 18px;
        border-radius: 32px;
        display: grid;
        place-items: center;
        font-size: 42px;
        color: white;
        background: linear-gradient(135deg, #f59e0b, #ec4899);
        box-shadow: 0 18px 36px rgba(236,72,153,.24);
    }

    @@media (max-width: 992px) {
        .hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-stat {
            width: 100%;
        }
    }

    @@media (max-width: 576px) {
        .saved-hero {
            padding: 26px;
        }

        .toolbar-vip {
            padding: 14px;
        }

        .bottom-actions {
            flex-direction: column;
        }

            .bottom-actions .btn {
                width: 100% !important;
            }
    }
</style>

<div class="saved-vip">
    <section class="saved-hero animate__animated animate__fadeIn">
        <div class="hero-inner">
            <div>
                <div class="hero-badge">
                    <i class="fas fa-bookmark text-warning"></i>
                    EDUTECH AI Saved Exams
                </div>

                <h1 class="hero-title">
                    Đề thi <span>đã lưu</span>
                </h1>

                <p class="hero-desc">
                    Lưu lại những đề quan trọng, luyện tập nhanh hơn và tiếp tục hành trình tăng điểm bất cứ lúc nào.
                </p>

                <div class="hero-actions">
                    <a asp-action="Index" class="hero-btn-main">
                        <i class="fas fa-layer-group me-2"></i>Tất cả đề thi
                    </a>

                    <a href="/Exam/History" class="hero-btn-ghost">
                        <i class="fas fa-clock-rotate-left me-2"></i>Lịch sử làm bài
                    </a>
                </div>
            </div>

            <div class="hero-stat">
                <div class="num" id="savedCount">@totalSaved</div>
                <div class="small fw-bold text-white-50 mt-2">Đề đã lưu</div>
            </div>
        </div>
    </section>

    <div class="toolbar-vip">
        <div class="row g-3 align-items-center">
            <div class="col-lg-8">
                <div class="search-box">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="text"
                           id="searchSaved"
                           class="form-control"
                           placeholder="Tìm kiếm đề đã lưu..." />
                </div>
            </div>

            <div class="col-lg-4 text-lg-end">
                <span class="badge rounded-pill bg-warning-subtle text-warning px-3 py-2 fw-bold">
                    <i class="fas fa-bookmark me-1"></i>
                    @totalSaved đề yêu thích
                </span>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state-vip">
            <div class="empty-icon">
                <i class="fas fa-bookmark"></i>
            </div>

            <h4 class="fw-black text-dark">Bạn chưa lưu đề thi nào</h4>

            <p class="text-muted mb-4">
                Bấm icon bookmark trên thẻ đề thi để lưu lại đề bạn muốn luyện sau.
            </p>

            <a asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="fas fa-compass me-2"></i>Khám phá đề thi
            </a>
        </div>
    }
    else
    {
        <div class="row g-4 saved-grid" id="savedGrid">
            @foreach (var item in Model)
            {
                var dt = item.DeThi;
                var mauDo = dt?.MucDoKho == "Dễ" ? "success" : dt?.MucDoKho == "Khó" ? "danger" : "warning";

                <div class="col-md-6 col-xl-4 saved-card-wrapper">
                    <div class="saved-card">
                        <div class="saved-card-body">
                            <div class="saved-top">
                                <span class="topic-badge">
                                    <i class="fas fa-layer-group"></i>
                                    @(dt?.ChuDe?.TenChuDe ?? "Chung")
                                </span>

                                <div class="d-flex gap-2 align-items-center">
                                    @if (!string.IsNullOrEmpty(dt?.MucDoKho))
                                    {
                                        <span class="level-badge bg-@mauDo-subtle text-@mauDo">
                                            @dt.MucDoKho
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="saved-icon">
                                <i class="fas fa-bookmark"></i>
                            </div>

                            <h5 class="saved-title saved-name">
                                @(dt?.TenDeThi ?? "Không rõ đề thi")
                            </h5>

                            <div class="meta-list">
                                <span class="meta-pill">
                                    <i class="far fa-clock text-info"></i>
                                    @(dt?.ThoiGian ?? 60) phút
                                </span>

                                <span class="meta-pill">
                                    <i class="fas fa-circle-question text-primary"></i>
                                    @(dt?.SoCauHoi ?? 0) câu
                                </span>

                                <span class="meta-pill">
                                    <i class="fas fa-calendar-check text-warning"></i>
                                    @item.NgayLuu.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </div>

                        <div class="saved-footer">
                            <a href="/Exam/Details/@dt?.MaDeThi" class="btn-start">
                                <i class="fas fa-play"></i>
                                Thi ngay
                            </a>

                            <div class="bottom-actions">
                                <a href="/Exam/Practice/@dt?.MaDeThi"
                                   class="btn btn-outline-info w-50">
                                    <i class="fas fa-book-open me-1"></i>Luyện tập
                                </a>

                                <button class="btn btn-outline-warning w-50 remove-save"
                                        data-id="@dt?.MaDeThi"
                                        data-bookmarked="true"
                                        onclick="toggleBookmark(this)">
                                    <i class="fas fa-bookmark me-1"></i>Bỏ lưu
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('searchSaved')?.addEventListener('input', function () {
            const kw = this.value.toLowerCase().trim();

            document.querySelectorAll('.saved-card-wrapper').forEach(card => {
                const name = card.querySelector('.saved-name')?.textContent.toLowerCase() || '';
                card.style.display = name.includes(kw) ? '' : 'none';
            });
        });

        async function toggleBookmark(btn) {
            const id = btn.dataset.id;

            if (!confirm('Bỏ lưu đề thi này?')) return;

            const res = await fetch('/Exam/ToggleBookmark', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: 'maDeThi=' + id
            });

            const data = await res.json();

            if (data.success && !data.isBookmarked) {
                const card = btn.closest('.saved-card-wrapper');

                if (card) {
                    card.style.transition = '.25s';
                    card.style.transform = 'scale(.96)';
                    card.style.opacity = '0';

                    setTimeout(() => {
                        card.remove();

                        const countEl = document.getElementById('savedCount');
                        if (countEl) {
                            const current = parseInt(countEl.textContent || '0');
                            countEl.textContent = Math.max(0, current - 1);
                        }
                    }, 250);
                }
            }
        }
    </script>

    @Html.AntiForgeryToken()
}