@model IEnumerable<DACS.Models.CauHoi>
@{
    var deThi = ViewBag.DeThi as DACS.Models.DeThi;
    bool isPractice = (bool)(ViewBag.IsPractice ?? false);
    ViewData["Title"] = isPractice ? "Luyện tập" : "Làm bài thi";
    int minutes = deThi?.ThoiGian ?? 60;
    int totalSecs = minutes * 60;
    int totalCau = Model.Count();
}

<style>
    .question-card {
        border-left: 4px solid #0d6efd;
        border-radius: 12px;
    }

        .question-card.practice-mode {
            border-left-color: #20c997;
        }

    .option-label {
        cursor: pointer;
        border: 1.5px solid #dee2e6;
        border-radius: 10px;
        padding: 12px 16px;
        transition: all 0.2s;
        display: block;
    }

        .option-label:hover {
            border-color: #0d6efd;
            background: #f0f5ff;
        }

    input[type=radio] {
        display: none;
    }

        input[type=radio]:checked + .option-label {
            border-color: #0d6efd;
            background: #e8f0fe;
            font-weight: 500;
        }

    .opt-correct .option-label {
        border-color: #198754 !important;
        background: #d1e7dd !important;
    }

    .opt-wrong .option-label {
        border-color: #dc3545 !important;
        background: #f8d7da !important;
    }

    #timer-box {
        position: sticky;
        top: 20px;
        z-index: 100;
    }

    .timer-danger {
        color: #dc3545 !important;
        animation: pulse 1s infinite;
    }

    #cheat-bar {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 9999;
        background: #dc3545;
        color: white;
        text-align: center;
        padding: 10px;
        font-weight: bold;
    }

    .ai-box {
        display: none;
        background: transparent;
        border: none;
        padding: 0;
        margin-top: 14px;
        font-size: .95rem;
    }

    .ai-detail {
        background: #f8fbff;
        border: 1px solid #bfdbfe;
        border-radius: 16px;
        padding: 18px;
        line-height: 1.7;
        font-size: 15px;
        box-shadow: 0 8px 24px rgba(37, 99, 235, .08);
    }

        .ai-detail h5 {
            color: #2563eb;
            font-weight: 800;
            margin-bottom: 15px;
        }

        .ai-detail p {
            margin-bottom: 6px;
        }

        .ai-detail ul {
            margin-bottom: 0;
            padding-left: 22px;
        }

    .q-nav-btn {
        min-width: 34px;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .5;
        }
    }

    @@keyframes popIn {
        from {
            transform: scale(.96);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

@if (!isPractice)
{
    <div id="cheat-bar">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <span id="cheat-msg">Cảnh báo: Bạn đã rời trang thi!</span>
    </div>
}

@if (isPractice)
{
    <div class="alert alert-success border-0 rounded-3 mb-4 d-flex align-items-center gap-3">
        <i class="fas fa-book-open fs-4"></i>
        <div>
            <strong>Chế độ luyện tập</strong> — Không giới hạn thời gian.
            Chọn đáp án để xem ngay đúng/sai.
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-9">
        <form method="post" action="/Exam/Submit" id="examForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maDethi" value="@deThi?.MaDeThi" />

            @{
                int stt = 1;
            }

            @foreach (var cau in Model)
            {
                <div class="card question-card @(isPractice ? "practice-mode" : "") shadow-sm mb-4 p-4"
                     id="q-@cau.MaCauHoi">

                    <p class="fw-bold mb-3">
                        <span class="badge bg-primary me-2">Câu @stt</span>@cau.NoiDung
                    </p>

                    @if (!string.IsNullOrEmpty(cau.AudioPath))
                    {
                        <div class="p-3 bg-light rounded mb-3 border">
                            <audio controls class="w-100">
                                <source src="@Url.Content("~/uploads/audio/" + cau.AudioPath)" type="audio/mpeg">
                            </audio>
                        </div>
                    }

                    @foreach (var opt in new[]
                    {
                        ("A", cau.PhuongAnA, cau.DapAnDung),
                        ("B", cau.PhuongAnB, cau.DapAnDung),
                        ("C", cau.PhuongAnC, cau.DapAnDung),
                        ("D", cau.PhuongAnD, cau.DapAnDung)
                    })
                    {
                        if (!string.IsNullOrEmpty(opt.Item2))
                        {
                            <div class="mb-2 opt-wrap"
                                 id="ow-@(cau.MaCauHoi)-@(opt.Item1)"
                                 data-key="@opt.Item1"
                                 data-correct="@opt.Item3">
                                <input type="radio"
                                       id="r-@(cau.MaCauHoi)-@(opt.Item1)"
                                       name="cauHoi_@cau.MaCauHoi"
                                       value="@opt.Item1" />
                                <label class="option-label"
                                       for="r-@(cau.MaCauHoi)-@(opt.Item1)">
                                    <span class="badge bg-secondary me-2">@opt.Item1</span>@opt.Item2
                                </label>
                            </div>
                        }
                    }

                    @if (isPractice)
                    {
                        <div class="ai-box" id="ai-@cau.MaCauHoi"></div>

                        <div class="d-flex gap-2 mt-2">
                            <button type="button"
                                    class="btn btn-outline-info btn-sm rounded-pill ai-btn"
                                    id="aibtn-@cau.MaCauHoi"
                                    data-id="@cau.MaCauHoi"
                                    style="display:none">
                                <i class="fas fa-robot me-1"></i>AI giải thích
                            </button>

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm rounded-pill"
                                    onclick="moModalBaoCao(@cau.MaCauHoi, @deThi!.MaDeThi, '@Html.Raw((cau.NoiDung ?? "").Replace("'", "\\'"))')">
                                <i class="fas fa-flag me-1"></i>Báo cáo lỗi
                            </button>
                        </div>
                    }
                </div>

                stt++;
            }

            @if (!isPractice)
            {
                <div class="d-grid gap-2 mb-5">
                    <button type="button" id="btnNop"
                            class="btn btn-success btn-lg rounded-pill fw-bold py-3">
                        <i class="fas fa-paper-plane me-2"></i>Nộp bài
                    </button>

                    <button type="button"
                            class="btn btn-outline-danger rounded-pill"
                            onclick="moModalBaoCao(null, @deThi!.MaDeThi, 'Báo cáo lỗi đề thi')">
                        <i class="fas fa-flag me-2"></i>Báo cáo lỗi trong đề thi này
                    </button>
                </div>
            }
        </form>
    </div>

    <div class="col-lg-3">
        <div id="timer-box">
            @if (!isPractice)
            {
                <div class="card shadow-sm mb-3 text-center p-3">
                    <div class="text-muted small mb-1">
                        <i class="fas fa-clock me-1"></i>Thời gian còn lại
                    </div>
                    <div id="timer" class="display-5 fw-bold text-primary">
                        @($"{minutes:D2}:00")
                    </div>
                </div>

                <div class="card shadow-sm mb-3 border-warning">
                    <div class="card-body p-3 text-center">
                        <div class="text-warning small fw-bold mb-1">
                            <i class="fas fa-eye me-1"></i>Chống gian lận
                        </div>
                        <div class="text-muted small">
                            Rời trang: <b id="cheatCount" class="text-danger">0</b>/3
                        </div>
                        <div class="progress mt-2" style="height:6px;">
                            <div id="cheatBar" class="progress-bar bg-danger" style="width:0%"></div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm mb-3 border-success text-center p-3">
                    <div class="text-success fw-bold">
                        <i class="fas fa-infinity me-1"></i>Không giới hạn thời gian
                    </div>
                    <div class="text-muted small mt-1">Chế độ luyện tập</div>
                </div>
            }

            <div class="card shadow-sm p-3">
                <div class="small fw-bold mb-2 text-muted">TIẾN ĐỘ LÀM BÀI</div>
                <div class="d-flex justify-content-between small mb-3">
                    <span>Đã chọn: <b id="answered">0</b></span>
                    <span>Tổng: <b>@totalCau</b></span>
                </div>

                <div class="d-flex flex-wrap gap-1" id="navGrid">
                    @{
                        int nav = 1;
                    }

                    @foreach (var cau in Model)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm q-nav-btn"
                                data-qid="@cau.MaCauHoi"
                                onclick="scrollToQ(@cau.MaCauHoi)">
                            @nav
                        </button>

                        nav++;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="backdrop" id="backdropBC" onclick="dongModalBaoCao()"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1040;"></div>

<div id="modalBaoCao"
     style="display:none;position:fixed;inset:0;z-index:1050;align-items:center;justify-content:center;padding:16px;overflow-y:auto;">

    <div style="background:#fff;border-radius:1rem;box-shadow:0 20px 60px rgba(0,0,0,.25);width:100%;max-width:480px;margin:auto;animation:popIn .2s ease;">

        <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px 0;">
            <h5 class="fw-bold m-0 text-danger">
                <i class="fas fa-flag me-2"></i>Báo cáo lỗi
            </h5>
            <button type="button" class="btn-close" onclick="dongModalBaoCao()"></button>
        </div>

        <form id="formBaoCao" onsubmit="guiBaoCao(event)">
            @Html.AntiForgeryToken()

            <input type="hidden" id="bc_maDeThi" name="maDeThi" />
            <input type="hidden" id="bc_maCauHoi" name="maCauHoi" />

            <div style="padding:20px 24px;">
                <div id="bc_cauHoiInfo" class="alert alert-light small py-2 mb-3" style="display:none;">
                    <i class="fas fa-question-circle text-primary me-1"></i>
                    <span id="bc_tenCauHoi"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">
                        Loại lỗi <span class="text-danger">*</span>
                    </label>
                    <select name="loaiBaoCao" id="bc_loai" class="form-select rounded-pill" required>
                        <option value="">-- Chọn loại lỗi --</option>
                        <option value="Sai đáp án">Sai đáp án</option>
                        <option value="Câu hỏi khó hiểu">Câu hỏi khó hiểu / mơ hồ</option>
                        <option value="Lỗi hiển thị">Lỗi hiển thị / hình ảnh</option>
                        <option value="Nội dung không phù hợp">Nội dung không phù hợp</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">
                        Mô tả chi tiết <span class="text-danger">*</span>
                    </label>
                    <textarea name="moTa"
                              id="bc_moTa"
                              class="form-control rounded-3"
                              rows="3"
                              placeholder="Ví dụ: Đáp án đúng phải là C vì..."
                              required
                              minlength="10"></textarea>
                    <div class="form-text">Tối thiểu 10 ký tự. Mô tả càng rõ càng được xử lý nhanh.</div>
                </div>

                <div id="bc_result" style="display:none;"></div>
            </div>

            <div style="padding:0 24px 24px;display:flex;gap:8px;">
                <button type="submit" id="bc_btnGui" class="btn btn-danger rounded-pill px-4 fw-bold w-100">
                    <i class="fas fa-paper-plane me-2"></i>Gửi báo cáo
                </button>
                <button type="button" class="btn btn-light rounded-pill px-4" onclick="dongModalBaoCao()">Hủy</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const IS_PRACTICE = @(isPractice ? "true" : "false");
        const TOTAL_SECS = @totalSecs;
        const TOTAL_CAU = @totalCau;

        let timerTick = null;

        if (!IS_PRACTICE) {
            let secs = TOTAL_SECS;
            const timerEl = document.getElementById('timer');

            timerTick = setInterval(() => {
                secs--;

                if (secs <= 0) {
                    clearInterval(timerTick);
                    autoSubmit('Hết giờ!');
                    return;
                }

                const m = String(Math.floor(secs / 60)).padStart(2, '0');
                const s = String(secs % 60).padStart(2, '0');

                timerEl.textContent = m + ':' + s;

                if (secs <= 300) {
                    timerEl.classList.add('timer-danger');
                }
            }, 1000);
        }

        if (!IS_PRACTICE) {
            document.getElementById('btnNop').addEventListener('click', function () {
                const answered = document.querySelectorAll('input[type=radio]:checked').length;

                const msg = answered < TOTAL_CAU
                    ? 'Còn ' + (TOTAL_CAU - answered) + ' câu chưa trả lời. Nộp bài không?'
                    : 'Bạn có chắc chắn muốn nộp bài?';

                if (confirm(msg)) {
                    clearInterval(timerTick);
                    document.getElementById('examForm').submit();
                }
            });
        }

        function autoSubmit(reason) {
            clearInterval(timerTick);

            const bar = document.getElementById('cheat-bar');
            const msg = document.getElementById('cheat-msg');

            if (msg) msg.textContent = '⏰ ' + reason + ' Đang nộp...';
            if (bar) bar.style.display = 'block';

            setTimeout(() => document.getElementById('examForm').submit(), 1500);
        }

        if (!IS_PRACTICE) {
            let tabCount = 0;

            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) return;

                tabCount++;

                const cntEl = document.getElementById('cheatCount');
                const barEl = document.getElementById('cheatBar');
                const warnEl = document.getElementById('cheat-bar');
                const msgEl = document.getElementById('cheat-msg');

                if (cntEl) cntEl.textContent = tabCount;
                if (barEl) barEl.style.width = (tabCount / 3 * 100) + '%';
                if (warnEl) warnEl.style.display = 'block';

                if (tabCount >= 3) {
                    if (msgEl) msgEl.textContent = '⚠️ Rời trang 3 lần! Tự động nộp bài...';
                    setTimeout(() => autoSubmit('Phát hiện gian lận!'), 2000);
                } else {
                    if (msgEl) msgEl.textContent = '⚠️ Cảnh báo ' + tabCount + '/3 — Còn ' + (3 - tabCount) + ' lần nữa sẽ tự nộp!';
                    setTimeout(() => {
                        if (warnEl) warnEl.style.display = 'none';
                    }, 3000);
                }
            });
        }

        function scrollToQ(id) {
            document.getElementById('q-' + id)?.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
        }

        function updateNav(name, chosen, correct) {
            const id = name.replace('cauHoi_', '');
            const btn = document.querySelector('.q-nav-btn[data-qid="' + id + '"]');

            if (!btn) return;

            if (IS_PRACTICE) {
                btn.className = 'btn btn-sm q-nav-btn ' +
                    (chosen === correct ? 'btn-success' : 'btn-danger');
            } else {
                btn.className = 'btn btn-outline-primary btn-sm q-nav-btn';
            }

            document.getElementById('answered').textContent =
                document.querySelectorAll('input[type=radio]:checked').length;
        }

        function handlePracticeAnswer(radio) {
            const name = radio.name;
            const chosen = radio.value;
            const qid = name.replace('cauHoi_', '');

            const firstWrap = document.querySelector('.opt-wrap[id^="ow-' + qid + '-"]');
            const correct = firstWrap ? firstWrap.dataset.correct : '';

            document.querySelectorAll('.opt-wrap[id^="ow-' + qid + '-"]').forEach(function (wrap) {
                const key = wrap.dataset.key;
                const inp = wrap.querySelector('input[type=radio]');

                if (inp) inp.disabled = true;

                wrap.classList.remove('opt-correct', 'opt-wrong');

                if (key === correct) {
                    wrap.classList.add('opt-correct');
                } else if (key === chosen && chosen !== correct) {
                    wrap.classList.add('opt-wrong');
                }
            });

            const aiBtn = document.getElementById('aibtn-' + qid);

            if (aiBtn) {
                aiBtn.style.display = 'inline-block';
            }

            updateNav(name, chosen, correct);
        }

        document.querySelectorAll('input[type=radio]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                if (IS_PRACTICE) {
                    handlePracticeAnswer(this);
                } else {
                    updateNav(this.name, this.value, '');
                }
            });
        });

        document.querySelectorAll('.ai-btn').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const qid = this.dataset.id;
                const radio = document.querySelector('input[name="cauHoi_' + qid + '"]:checked');
                const chosen = radio ? radio.value : '';
                const wrap = document.querySelector('.opt-wrap[id^="ow-' + qid + '-"]');
                const correct = wrap ? wrap.dataset.correct : '';
                const box = document.getElementById('ai-' + qid);

                this.disabled = true;
                this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Đang hỏi giảng viên AI...';

                box.style.display = 'block';
                box.innerHTML =
                    '<div class="ai-detail">' +
                        '<h5>🤖 Giảng viên AI đang phân tích...</h5>' +
                        '<p class="mb-0">Vui lòng chờ trong giây lát.</p>' +
                    '</div>';

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

                    const body = new URLSearchParams({
                        maCauHoi: qid,
                        dapAnChon: chosen,
                        dapAnDung: correct,
                        __RequestVerificationToken: token
                    });

                    const res = await fetch('/Exam/GiaiThichAI', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: body.toString()
                    });

                    const data = await res.json();

                    if (data.success) {
                        box.innerHTML = data.message;
                    } else {
                        box.innerHTML =
                            '<div class="alert alert-danger rounded-3 mb-0">' +
                                '<i class="fas fa-times-circle me-1"></i>' +
                                (data.message || 'Không thể lấy giải thích từ AI.') +
                            '</div>';
                    }
                } catch (e) {
                    box.innerHTML =
                        '<div class="alert alert-danger rounded-3 mb-0">' +
                            '<i class="fas fa-wifi me-1"></i>Lỗi kết nối AI. Vui lòng thử lại.' +
                        '</div>';
                }

                this.disabled = false;
                this.innerHTML = '<i class="fas fa-robot me-1"></i>AI giải thích';
            });
        });

        function moModalBaoCao(maCauHoi, maDeThi, tenCauHoi) {
            document.getElementById('bc_maDeThi').value = maDeThi;
            document.getElementById('bc_maCauHoi').value = maCauHoi || '';
            document.getElementById('bc_loai').value = '';
            document.getElementById('bc_moTa').value = '';
            document.getElementById('bc_result').style.display = 'none';
            document.getElementById('bc_btnGui').disabled = false;
            document.getElementById('bc_btnGui').innerHTML = '<i class="fas fa-paper-plane me-2"></i>Gửi báo cáo';

            const infoBox = document.getElementById('bc_cauHoiInfo');
            const tenEl = document.getElementById('bc_tenCauHoi');

            if (maCauHoi) {
                tenEl.textContent = tenCauHoi || 'Câu hỏi #' + maCauHoi;
                infoBox.style.display = 'block';
            } else {
                infoBox.style.display = 'none';
            }

            const modal = document.getElementById('modalBaoCao');
            modal.style.display = 'flex';

            document.getElementById('backdropBC').style.display = 'block';
            document.body.style.overflow = 'hidden';
        }

        function dongModalBaoCao() {
            document.getElementById('modalBaoCao').style.display = 'none';
            document.getElementById('backdropBC').style.display = 'none';
            document.body.style.overflow = '';
        }

        async function guiBaoCao(e) {
            e.preventDefault();

            const form = document.getElementById('formBaoCao');
            const btn = document.getElementById('bc_btnGui');
            const result = document.getElementById('bc_result');
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang gửi...';

            const data = new URLSearchParams({
                maDeThi: document.getElementById('bc_maDeThi').value,
                maCauHoi: document.getElementById('bc_maCauHoi').value,
                loaiBaoCao: document.getElementById('bc_loai').value,
                moTa: document.getElementById('bc_moTa').value,
                __RequestVerificationToken: token
            });

            try {
                const res = await fetch('/BaoCao/GuiBaoCao', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: data.toString()
                });

                const json = await res.json();

                result.style.display = 'block';
                result.innerHTML = json.success
                    ? '<div class="alert alert-success small py-2"><i class="fas fa-check-circle me-1"></i>' + json.message + '</div>'
                    : '<div class="alert alert-danger small py-2"><i class="fas fa-times-circle me-1"></i>' + json.message + '</div>';

                if (json.success) {
                    setTimeout(dongModalBaoCao, 2500);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Gửi báo cáo';
                }
            } catch (err) {
                result.style.display = 'block';
                result.innerHTML = '<div class="alert alert-danger small py-2">Lỗi kết nối. Vui lòng thử lại.</div>';
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Gửi báo cáo';
            }
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                dongModalBaoCao();
            }
        });
    </script>
}