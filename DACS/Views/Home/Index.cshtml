@model DACS.Models.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ học tập";
}

<style>
    .home-page {
        position: relative;
        overflow: hidden;
    }

        .home-page::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 15% 10%, rgba(99,102,241,.22), transparent 28%), radial-gradient(circle at 85% 20%, rgba(34,211,238,.20), transparent 30%), radial-gradient(circle at 50% 95%, rgba(236,72,153,.12), transparent 35%);
            z-index: -1;
        }

    .mega-hero {
        position: relative;
        border-radius: 34px;
        padding: 42px;
        color: white;
        overflow: hidden;
        min-height: 280px;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.92)), radial-gradient(circle at 20% 20%, #6366f1, transparent 35%), radial-gradient(circle at 80% 30%, #22d3ee, transparent 35%);
        box-shadow: 0 30px 80px rgba(15,23,42,.28);
        border: 1px solid rgba(255,255,255,.15);
    }

        .mega-hero::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,.18), transparent);
            transform: translateX(-100%);
            animation: shine 5s infinite;
        }

    @@keyframes shine {
        0% {
            transform: translateX(-100%);
        }

        45%, 100% {
            transform: translateX(100%);
        }
    }

    .hero-orb {
        position: absolute;
        width: 260px;
        height: 260px;
        right: 40px;
        top: 35px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #22d3ee, #ec4899);
        filter: blur(.2px);
        opacity: .9;
        box-shadow: 0 0 80px rgba(34,211,238,.45);
        animation: floatOrb 4s ease-in-out infinite;
    }

        .hero-orb::before {
            content: "AI";
            position: absolute;
            inset: 26px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: rgba(15,23,42,.85);
            color: white;
            font-size: 72px;
            font-weight: 900;
            letter-spacing: -4px;
            border: 1px solid rgba(255,255,255,.22);
        }

        .hero-orb::after {
            content: "🚀";
            position: absolute;
            right: -18px;
            top: -24px;
            font-size: 58px;
            filter: drop-shadow(0 12px 18px rgba(0,0,0,.35));
        }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translateY(0) rotate(0);
        }

        50% {
            transform: translateY(-14px) rotate(5deg);
        }
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 720px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(12px);
        font-size: .85rem;
        font-weight: 700;
    }

    .hero-title {
        font-size: clamp(2rem, 4vw, 4.2rem);
        line-height: .98;
        font-weight: 950;
        letter-spacing: -2px;
        margin: 20px 0;
    }

        .hero-title span {
            background: linear-gradient(90deg, #a5f3fc, #c4b5fd, #f9a8d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-subtitle {
        color: #cbd5e1;
        font-size: 1.05rem;
        max-width: 620px;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 26px;
    }

    .btn-neon {
        border: 0;
        border-radius: 999px;
        padding: 13px 22px;
        font-weight: 800;
        color: #0f172a;
        background: linear-gradient(135deg, #ffffff, #dbeafe);
        box-shadow: 0 18px 35px rgba(255,255,255,.16);
        transition: .25s;
        text-decoration: none;
    }

        .btn-neon:hover {
            transform: translateY(-3px) scale(1.02);
            color: #4338ca;
        }

    .btn-ghost-hero {
        border-radius: 999px;
        padding: 13px 22px;
        font-weight: 800;
        color: white;
        border: 1px solid rgba(255,255,255,.2);
        background: rgba(255,255,255,.08);
        text-decoration: none;
        transition: .25s;
    }

        .btn-ghost-hero:hover {
            background: rgba(255,255,255,.15);
            color: white;
            transform: translateY(-3px);
        }

    .stat-card-pro {
        position: relative;
        overflow: hidden;
        border: 0;
        border-radius: 26px;
        padding: 24px;
        background: rgba(255,255,255,.82);
        backdrop-filter: blur(18px);
        box-shadow: 0 20px 45px rgba(15,23,42,.08);
        transition: .25s;
        height: 100%;
    }

        .stat-card-pro:hover {
            transform: translateY(-8px);
            box-shadow: 0 28px 70px rgba(15,23,42,.14);
        }

        .stat-card-pro::after {
            content: "";
            position: absolute;
            width: 140px;
            height: 140px;
            right: -48px;
            top: -48px;
            border-radius: 50%;
            background: var(--glow);
            opacity: .18;
        }

    .stat-icon {
        width: 58px;
        height: 58px;
        display: grid;
        place-items: center;
        border-radius: 20px;
        color: white;
        font-size: 25px;
        background: var(--grad);
        box-shadow: 0 15px 30px var(--shadow);
        margin-bottom: 16px;
    }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 950;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 16px;
        margin: 38px 0 18px;
    }

    .section-title {
        font-size: 1.55rem;
        font-weight: 950;
        color: #0f172a;
        margin: 0;
    }

    .section-desc {
        color: #64748b;
        margin: 5px 0 0;
    }

    .exam-card-pro {
        position: relative;
        height: 100%;
        border: 0;
        border-radius: 28px;
        padding: 24px;
        background: rgba(255,255,255,.88);
        backdrop-filter: blur(18px);
        box-shadow: 0 20px 45px rgba(15,23,42,.08);
        overflow: hidden;
        transition: .25s;
    }

        .exam-card-pro:hover {
            transform: translateY(-9px);
            box-shadow: 0 32px 80px rgba(15,23,42,.15);
        }

        .exam-card-pro::before {
            content: "";
            position: absolute;
            inset: 0;
            height: 6px;
            background: linear-gradient(90deg, #6366f1, #22d3ee, #ec4899);
        }

    .exam-icon {
        width: 54px;
        height: 54px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #eef2ff, #ecfeff);
        color: #4f46e5;
        font-size: 24px;
        margin-bottom: 18px;
    }

    .exam-title {
        font-weight: 900;
        font-size: 1.08rem;
        color: #0f172a;
        min-height: 52px;
    }

    .exam-meta {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin: 14px 0 20px;
    }

    .meta-pill {
        font-size: .75rem;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #475569;
        font-weight: 700;
    }

    .btn-exam {
        width: 100%;
        border: 0;
        border-radius: 16px;
        padding: 11px 14px;
        color: white;
        font-weight: 850;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 14px 28px rgba(79,70,229,.25);
        transition: .22s;
    }

        .btn-exam:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 18px 38px rgba(79,70,229,.35);
        }

    .empty-state {
        border-radius: 28px;
        padding: 42px;
        text-align: center;
        background: rgba(255,255,255,.82);
        box-shadow: 0 20px 45px rgba(15,23,42,.08);
    }

    @@media (max-width: 992px) {
        .mega-hero {
            padding: 30px;
        }

        .hero-orb {
            position: relative;
            right: auto;
            top: auto;
            width: 170px;
            height: 170px;
            margin-top: 30px;
        }

            .hero-orb::before {
                font-size: 48px;
            }

        .section-head {
            align-items: start;
            flex-direction: column;
        }
    }
</style>

<div class="home-page">
    <section class="mega-hero animate__animated animate__fadeIn">
        <div class="hero-content">
            <div class="hero-badge">
                <i class="fas fa-wand-magic-sparkles text-info"></i>
                EDUTECH AI — học thông minh, bứt phá điểm số
            </div>

            <h1 class="hero-title">
                Chào mừng trở lại,<br />
                <span>@(User.Identity?.Name ?? "Người học")</span>
            </h1>

            <p class="hero-subtitle">
                Bắt đầu luyện đề, theo dõi tiến độ, lưu đề yêu thích và để AI đề xuất lộ trình học phù hợp với năng lực của bạn.
            </p>

            <div class="hero-actions">
                <a href="/AI/Roadmap" class="btn-neon">
                    <i class="fas fa-route me-2"></i> Tiếp tục lộ trình
                </a>
                <a href="/Exam/Index" class="btn-ghost-hero">
                    <i class="fas fa-layer-group me-2"></i> Khám phá đề thi
                </a>
            </div>
        </div>

        <div class="hero-orb d-none d-lg-block"></div>
    </section>

    <div class="row g-4 mt-1">
        <div class="col-md-6 col-xl-3">
            <div class="stat-card-pro"
                 style="--grad:linear-gradient(135deg,#4f46e5,#06b6d4);--shadow:rgba(79,70,229,.28);--glow:#4f46e5;">
                <div class="stat-icon">
                    <i class="fas fa-book-open"></i>
                </div>
                <div class="stat-value">@Model.SoDeDaHoanThanh</div>
                <div class="text-muted fw-semibold">Đề thi đã hoàn thành</div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card-pro"
                 style="--grad:linear-gradient(135deg,#16a34a,#22c55e);--shadow:rgba(34,197,94,.28);--glow:#22c55e;">
                <div class="stat-icon">
                    <i class="fas fa-check-double"></i>
                </div>
                <div class="stat-value">@Model.TiLeDungTrungBinh.ToString("F0")%</div>
                <div class="text-muted fw-semibold">Tỉ lệ trả lời đúng</div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card-pro"
                 style="--grad:linear-gradient(135deg,#f97316,#f59e0b);--shadow:rgba(249,115,22,.28);--glow:#f97316;">
                <div class="stat-icon">
                    <i class="fas fa-fire"></i>
                </div>
                <div class="stat-value">
                    @(Model.SoDeDaHoanThanh > 0 ? "Hot" : "New")
                </div>
                <div class="text-muted fw-semibold">Trạng thái học tập</div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card-pro"
                 style="--grad:linear-gradient(135deg,#db2777,#ec4899);--shadow:rgba(236,72,153,.28);--glow:#ec4899;">
                <div class="stat-icon">
                    <i class="fas fa-brain"></i>
                </div>
                <div class="stat-value">AI</div>
                <div class="text-muted fw-semibold">Gợi ý lộ trình cá nhân</div>
            </div>
        </div>
    </div>

    <div class="section-head">
        <div>
            <h2 class="section-title">Đề thi nổi bật</h2>
            <p class="section-desc">Chọn một đề và bắt đầu phá đảo kiến thức ngay hôm nay.</p>
        </div>

        <a href="/Exam/Index" class="btn btn-dark rounded-pill px-4 fw-bold">
            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @if (Model.DanhSachDeThi != null && Model.DanhSachDeThi.Any())
        {
            foreach (var item in Model.DanhSachDeThi)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="exam-card-pro">
                        <div class="exam-icon">
                            <i class="fas fa-file-circle-question"></i>
                        </div>

                        <h5 class="exam-title">@item.TenDeThi</h5>

                        <div class="exam-meta">
                            <span class="meta-pill">
                                <i class="fas fa-bolt me-1 text-warning"></i> Luyện nhanh
                            </span>
                            <span class="meta-pill">
                                <i class="fas fa-chart-line me-1 text-primary"></i> Có chấm điểm
                            </span>
                            <span class="meta-pill">
                                <i class="fas fa-robot me-1 text-info"></i> AI hỗ trợ
                            </span>
                        </div>

                        <a href="/Exam/Details/@item.MaDeThi" class="btn-exam">
                            Làm bài ngay <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="empty-state">
                    <div class="display-4 mb-3">📚</div>
                    <h4 class="fw-bold">Chưa có đề thi nào</h4>
                    <p class="text-muted mb-0">Hãy tạo hoặc thêm đề thi để bắt đầu học tập.</p>
                </div>
            </div>
        }
    </div>
</div>