@using DACS.Models
@{
    ViewData["Title"] = "Tiến trình học tập";

    var phanTichChuDe = ViewBag.PhanTichChuDe as IEnumerable<dynamic> ?? new List<dynamic>();
    var goiY = ViewBag.GoiY as List<string> ?? new List<string>();

    int tongBaiBai = ViewBag.TongBaiBai ?? 0;
    double diemTB = ViewBag.DiemTrungBinh ?? 0;

    var lichSu = ViewBag.LichSu as IEnumerable<KetQuaThi> ?? new List<KetQuaThi>();
}

<style>
    .roadmap-vip {
        position: relative;
        padding-bottom: 36px;
    }

        .roadmap-vip::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 14% 8%, rgba(99,102,241,.23), transparent 28%), radial-gradient(circle at 88% 12%, rgba(34,211,238,.20), transparent 30%), radial-gradient(circle at 48% 100%, rgba(236,72,153,.13), transparent 35%);
            z-index: -1;
        }

    .roadmap-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 38px;
        color: white;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.93)), radial-gradient(circle at 20% 20%, rgba(99,102,241,.9), transparent 34%), radial-gradient(circle at 86% 25%, rgba(34,211,238,.68), transparent 36%), radial-gradient(circle at 55% 95%, rgba(236,72,153,.45), transparent 38%);
        box-shadow: 0 34px 90px rgba(15,23,42,.26);
        border: 1px solid rgba(255,255,255,.15);
    }

        .roadmap-hero::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,.18), transparent);
            transform: translateX(-100%);
            animation: heroShine 5.5s infinite;
        }

    @@keyframes heroShine {
        0% {
            transform: translateX(-100%);
        }

        45%, 100% {
            transform: translateX(100%);
        }
    }

    .roadmap-hero::after {
        content: "🤖";
        position: absolute;
        right: 42px;
        bottom: -36px;
        font-size: 170px;
        opacity: .13;
        filter: drop-shadow(0 20px 25px rgba(0,0,0,.35));
    }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 28px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(14px);
        color: #e0f2fe;
        font-size: .82rem;
        font-weight: 850;
    }

    .hero-title {
        margin: 18px 0 10px;
        font-size: clamp(2rem, 4vw, 4rem);
        font-weight: 950;
        line-height: .95;
        letter-spacing: -2px;
    }

        .hero-title span {
            background: linear-gradient(90deg, #a5f3fc, #c4b5fd, #f9a8d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-desc {
        max-width: 670px;
        color: #cbd5e1;
        font-size: 1.02rem;
        margin: 0;
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .hero-btn-main,
    .hero-btn-ghost {
        border-radius: 999px;
        padding: 13px 20px;
        font-weight: 900;
        text-decoration: none;
        transition: .22s;
    }

    .hero-btn-main {
        color: #0f172a;
        background: linear-gradient(135deg, #ffffff, #dbeafe);
        box-shadow: 0 16px 34px rgba(255,255,255,.16);
    }

        .hero-btn-main:hover {
            color: #4338ca;
            transform: translateY(-3px);
        }

    .hero-btn-ghost {
        color: white;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.18);
    }

        .hero-btn-ghost:hover {
            color: white;
            background: rgba(255,255,255,.16);
            transform: translateY(-3px);
        }

    .hero-score {
        min-width: 210px;
        border-radius: 30px;
        padding: 28px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(16px);
        text-align: center;
    }

        .hero-score .num {
            font-size: 3.2rem;
            font-weight: 950;
            line-height: 1;
        }

    .stats-grid {
        margin-top: -52px;
        position: relative;
        z-index: 5;
    }

    .stat-vip {
        position: relative;
        overflow: hidden;
        height: 100%;
        border-radius: 28px;
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        padding: 24px;
        box-shadow: 0 22px 55px rgba(15,23,42,.10);
        transition: .25s;
    }

        .stat-vip:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 76px rgba(15,23,42,.16);
        }

        .stat-vip::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -58px;
            top: -58px;
            border-radius: 50%;
            background: var(--glow);
            opacity: .17;
        }

    .stat-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 24px;
        background: var(--grad);
        box-shadow: 0 15px 30px var(--shadow);
        margin-bottom: 15px;
    }

    .stat-num {
        font-size: 2.25rem;
        font-weight: 950;
        line-height: 1;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .stat-label {
        color: #64748b;
        font-size: .88rem;
        font-weight: 700;
        margin-top: 8px;
    }

    .panel-vip {
        margin-top: 28px;
        border-radius: 32px;
        border: 1px solid rgba(255,255,255,.75);
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        box-shadow: 0 22px 55px rgba(15,23,42,.09);
        overflow: hidden;
    }

    .panel-head {
        padding: 24px 28px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
    }

    .panel-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.28rem;
        font-weight: 950;
    }

    .panel-sub {
        color: #64748b;
        font-size: .88rem;
        font-weight: 700;
        margin-top: 4px;
    }

    .panel-body {
        padding: 28px;
    }

    .topic-row {
        margin-bottom: 22px;
    }

    .topic-name {
        color: #0f172a;
        font-weight: 900;
    }

    .topic-score {
        font-weight: 950;
    }

    .progress-vip {
        height: 15px;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
        box-shadow: inset 0 2px 4px rgba(15,23,42,.08);
    }

        .progress-vip span {
            display: block;
            height: 100%;
            width: var(--value);
            border-radius: 999px;
            background: var(--bar);
            box-shadow: 0 8px 18px var(--shadow);
        }

    .ai-card {
        border-radius: 28px;
        padding: 24px;
        color: white;
        overflow: hidden;
        position: relative;
        background: linear-gradient(135deg, rgba(79,70,229,.96), rgba(6,182,212,.95)), radial-gradient(circle at 90% 10%, rgba(255,255,255,.28), transparent 26%);
        box-shadow: 0 24px 60px rgba(79,70,229,.22);
    }

        .ai-card::after {
            content: "✦";
            position: absolute;
            right: 20px;
            top: 12px;
            font-size: 80px;
            opacity: .16;
        }

    .ai-title {
        position: relative;
        z-index: 2;
        font-size: 1.2rem;
        font-weight: 950;
        margin-bottom: 14px;
    }

    .ai-suggestion {
        position: relative;
        z-index: 2;
        border-radius: 18px;
        padding: 13px 15px;
        margin-bottom: 10px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(14px);
        font-size: .88rem;
        font-weight: 700;
    }

    .history-mini {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid #e2e8f0;
    }

        .history-mini:last-child {
            border-bottom: 0;
        }

    .history-title {
        font-weight: 900;
        color: #0f172a;
        font-size: .9rem;
    }

    .history-date {
        color: #64748b;
        font-size: .76rem;
        font-weight: 700;
        margin-top: 3px;
    }

    .score-badge {
        min-width: 62px;
        text-align: center;
        border-radius: 999px;
        padding: 8px 12px;
        color: white;
        font-weight: 950;
        background: var(--scoreColor);
        box-shadow: 0 12px 24px var(--scoreShadow);
    }

    .empty-state-vip {
        margin-top: 28px;
        border-radius: 34px;
        padding: 58px 24px;
        text-align: center;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .empty-icon {
        width: 92px;
        height: 92px;
        margin: 0 auto 18px;
        border-radius: 32px;
        display: grid;
        place-items: center;
        font-size: 42px;
        color: white;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 18px 36px rgba(79,70,229,.24);
    }

    @@media (max-width: 992px) {
        .hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-score {
            width: 100%;
        }

        .stats-grid {
            margin-top: 22px;
        }

        .panel-head {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 576px) {
        .roadmap-hero {
            padding: 26px;
        }

        .panel-body {
            padding: 22px;
        }
    }
</style>

<div class="roadmap-vip">
    <section class="roadmap-hero animate__animated animate__fadeIn">
        <div class="hero-inner">
            <div>
                <div class="hero-badge">
                    <i class="fas fa-robot text-info"></i>
                    EDUTECH AI Personal Roadmap
                </div>

                <h1 class="hero-title">
                    Tiến trình <span>học tập</span>
                </h1>

                <p class="hero-desc">
                    AI phân tích kết quả làm bài, đo sức mạnh từng chủ đề và đề xuất lộ trình ôn tập cá nhân hóa cho bạn.
                </p>

                <div class="hero-actions">
                    <a href="/Exam/Index" class="hero-btn-main">
                        <i class="fas fa-play me-2"></i>Làm bài mới
                    </a>

                    <a href="/Exam/History" class="hero-btn-ghost">
                        <i class="fas fa-clock-rotate-left me-2"></i>Xem lịch sử
                    </a>
                </div>
            </div>

            <div class="hero-score">
                <div class="num">@diemTB.ToString("F1")</div>
                <div class="small fw-bold text-white-50 mt-2">Điểm trung bình</div>
            </div>
        </div>
    </section>

    <div class="row g-4 stats-grid">
        <div class="col-md-4">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#4f46e5,#06b6d4);--shadow:rgba(79,70,229,.28);--glow:#4f46e5;">
                <div class="stat-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <div class="stat-num">@tongBaiBai</div>
                <div class="stat-label">Đề thi đã hoàn thành</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#16a34a,#22c55e);--shadow:rgba(34,197,94,.28);--glow:#22c55e;">
                <div class="stat-icon">
                    <i class="fas fa-star"></i>
                </div>
                <div class="stat-num">@diemTB.ToString("F1")</div>
                <div class="stat-label">Điểm trung bình</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#db2777,#ec4899);--shadow:rgba(236,72,153,.28);--glow:#ec4899;">
                <div class="stat-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div class="stat-num">@phanTichChuDe.Count()</div>
                <div class="stat-label">Chủ đề đã luyện tập</div>
            </div>
        </div>
    </div>

    @if (tongBaiBai == 0)
    {
        <div class="empty-state-vip">
            <div class="empty-icon">
                <i class="fas fa-chart-simple"></i>
            </div>

            <h4 class="fw-black text-dark">Bạn chưa làm bài thi nào</h4>

            <p class="text-muted mb-4">
                Hãy bắt đầu làm bài để AI có dữ liệu phân tích tiến trình học tập.
            </p>

            <a href="/Exam/Index" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="fas fa-play me-2"></i>Đi thi ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="panel-vip">
                    <div class="panel-head">
                        <div>
                            <h5 class="panel-title">
                                <i class="fas fa-chart-bar me-2 text-primary"></i>
                                Tỉ lệ đúng theo chủ đề
                            </h5>
                            <div class="panel-sub">Đánh giá sức mạnh từng mảng kiến thức</div>
                        </div>
                    </div>

                    <div class="panel-body">
                        @foreach (var cd in phanTichChuDe)
                        {
                            double tiLe = cd.TiLeDung;
                            string mau = tiLe >= 80
                                ? "linear-gradient(135deg,#16a34a,#22c55e)"
                                : tiLe >= 50
                                    ? "linear-gradient(135deg,#f59e0b,#f97316)"
                                    : "linear-gradient(135deg,#dc2626,#f97316)";

                            string shadow = tiLe >= 80
                                ? "rgba(34,197,94,.28)"
                                : tiLe >= 50
                                    ? "rgba(249,115,22,.28)"
                                    : "rgba(239,68,68,.28)";

                            string textColor = tiLe >= 80 ? "#16a34a" : tiLe >= 50 ? "#f59e0b" : "#dc2626";

                            <div class="topic-row">
                                <div class="d-flex justify-content-between small mb-2">
                                    <span class="topic-name">@cd.ChuDe</span>
                                    <span class="topic-score" style="color:@textColor;">
                                        @tiLe.ToString("F0")% (@cd.SoDung/@(cd.SoDung + cd.SoSai) câu)
                                    </span>
                                </div>

                                <div class="progress-vip">
                                    <span style="--value:@tiLe.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;--bar:@mau;--shadow:@shadow;"></span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="ai-card mb-4">
                    <div class="ai-title">
                        <i class="fas fa-wand-magic-sparkles me-2"></i>
                        Gợi ý học tập AI
                    </div>

                    @if (!goiY.Any())
                    {
                        <div class="ai-suggestion">
                            <i class="fas fa-circle-info me-2"></i>
                            Chưa có đủ dữ liệu để phân tích. Hãy làm thêm nhiều đề!
                        </div>
                    }
                    else
                    {
                        @foreach (var y in goiY)
                        {
                            bool laCanhBao = y.Contains("Cần");

                            <div class="ai-suggestion">
                                <i class="fas @(laCanhBao ? "fa-triangle-exclamation text-warning" : "fa-circle-check text-success") me-2"></i>
                                @Html.Raw(y)
                            </div>
                        }
                    }
                </div>

                <div class="panel-vip mt-0">
                    <div class="panel-head">
                        <div>
                            <h5 class="panel-title">
                                <i class="fas fa-history me-2 text-secondary"></i>
                                Lịch sử gần đây
                            </h5>
                            <div class="panel-sub">5 lần làm bài mới nhất</div>
                        </div>
                    </div>

                    <div class="panel-body">
                        @if (!lichSu.Any())
                        {
                            <div class="text-muted small fw-semibold">
                                Chưa có lịch sử làm bài.
                            </div>
                        }
                        else
                        {
                            @foreach (var kq in lichSu.Take(5))
                            {
                                string scoreColor = kq.TongDiem >= 8
                                    ? "linear-gradient(135deg,#16a34a,#22c55e)"
                                    : kq.TongDiem >= 5
                                        ? "linear-gradient(135deg,#4f46e5,#06b6d4)"
                                        : "linear-gradient(135deg,#dc2626,#f97316)";

                                string scoreShadow = kq.TongDiem >= 8
                                    ? "rgba(34,197,94,.28)"
                                    : kq.TongDiem >= 5
                                        ? "rgba(79,70,229,.28)"
                                        : "rgba(239,68,68,.28)";

                                <div class="history-mini">
                                    <div>
                                        <div class="history-title">@(kq.DeThi?.TenDeThi ?? "Đề thi")</div>
                                        <div class="history-date">
                                            <i class="far fa-calendar me-1"></i>
                                            @kq.NgayThi.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>

                                    <span class="score-badge"
                                          style="--scoreColor:@scoreColor;--scoreShadow:@scoreShadow;">
                                        @kq.TongDiem đ
                                    </span>
                                </div>
                            }

                            <div class="text-end mt-3">
                                <a href="/Exam/History" class="btn btn-outline-primary rounded-pill btn-sm px-3 fw-bold">
                                    Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>