@model IEnumerable<DACS.Models.ApplicationUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> _userManager

@{
    ViewData["Title"] = "Quản lý người dùng";
    var users = Model?.ToList() ?? new List<DACS.Models.ApplicationUser>();
    int totalUsers = users.Count;
}


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3 mx-4 mt-3">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3 mx-4 mt-3">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<style>
    .users-vip {
        position: relative;
        padding-bottom: 36px;
    }

        .users-vip::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 14% 8%, rgba(99,102,241,.23), transparent 28%), radial-gradient(circle at 88% 12%, rgba(34,211,238,.20), transparent 30%), radial-gradient(circle at 48% 100%, rgba(236,72,153,.13), transparent 35%);
            z-index: -1;
        }

    .users-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 38px;
        color: white;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.93)), radial-gradient(circle at 20% 20%, rgba(99,102,241,.9), transparent 34%), radial-gradient(circle at 86% 25%, rgba(34,211,238,.68), transparent 36%), radial-gradient(circle at 55% 95%, rgba(236,72,153,.45), transparent 38%);
        box-shadow: 0 34px 90px rgba(15,23,42,.26);
        border: 1px solid rgba(255,255,255,.15);
    }

        .users-hero::after {
            content: "👥";
            position: absolute;
            right: 42px;
            bottom: -36px;
            font-size: 170px;
            opacity: .13;
        }

    .hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 28px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(14px);
        color: #e0f2fe;
        font-size: .82rem;
        font-weight: 850;
    }

    .hero-title {
        margin: 18px 0 10px;
        font-size: clamp(2rem, 4vw, 4rem);
        font-weight: 950;
        line-height: .95;
        letter-spacing: -2px;
    }

        .hero-title span {
            background: linear-gradient(90deg, #a5f3fc, #c4b5fd, #f9a8d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    .hero-desc {
        max-width: 660px;
        color: #cbd5e1;
        font-size: 1.02rem;
        margin: 0;
    }

    .hero-stat {
        min-width: 190px;
        border-radius: 30px;
        padding: 26px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(16px);
        text-align: center;
    }

        .hero-stat .num {
            font-size: 3.1rem;
            font-weight: 950;
            line-height: 1;
        }

    .toolbar-vip {
        margin-top: 24px;
        padding: 18px;
        border-radius: 28px;
        background: rgba(255,255,255,.88);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
        }

        .search-box input {
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            padding: 14px 18px 14px 46px;
            font-weight: 750;
            background: #f8fafc;
        }

            .search-box input:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 .25rem rgba(99,102,241,.15);
                background: white;
            }

    .users-panel {
        margin-top: 26px;
        border-radius: 32px;
        overflow: hidden;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,.75);
        box-shadow: 0 22px 55px rgba(15,23,42,.09);
    }

    .users-table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .users-table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            font-weight: 950;
            border-bottom: 1px solid #e2e8f0;
            padding: 18px 22px;
        }

        .users-table tbody td {
            padding: 18px 22px;
            vertical-align: middle;
            border-bottom: 1px solid #e2e8f0;
        }

        .users-table tbody tr {
            transition: .2s;
        }

            .users-table tbody tr:hover {
                background: #f8fafc;
            }

    .user-avatar {
        width: 48px;
        height: 48px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        color: white;
        font-weight: 950;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 14px 26px rgba(79,70,229,.22);
        flex-shrink: 0;
    }

    .user-name {
        font-weight: 950;
        color: #0f172a;
    }

    .user-email {
        color: #64748b;
        font-size: .82rem;
        font-weight: 650;
    }

    .role-select {
        min-width: 150px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background-color: #f8fafc;
        font-weight: 800;
        padding: 8px 14px;
    }

        .role-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 .2rem rgba(99,102,241,.15);
        }

    .btn-save-role {
        border-radius: 999px;
        font-weight: 850;
        padding-left: 16px;
        padding-right: 16px;
    }

    .btn-delete-user {
        border-radius: 999px;
        font-weight: 850;
        padding-left: 16px;
        padding-right: 16px;
    }

    .role-badge-preview {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .75rem;
        font-weight: 900;
        background: #eef2ff;
        color: #4f46e5;
        margin-left: 8px;
    }

    .empty-state-vip {
        border-radius: 34px;
        padding: 58px 24px;
        text-align: center;
        background: rgba(255,255,255,.9);
        backdrop-filter: blur(18px);
    }

    .empty-icon {
        width: 92px;
        height: 92px;
        margin: 0 auto 18px;
        border-radius: 32px;
        display: grid;
        place-items: center;
        font-size: 42px;
        color: white;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 18px 36px rgba(79,70,229,.24);
    }

    @@media (max-width: 992px) {
        .hero-inner {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-stat {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .users-hero {
            padding: 26px;
        }

        .role-form {
            flex-direction: column;
            align-items: stretch !important;
        }

        .role-select {
            width: 100%;
        }
    }
</style>

<div class="users-vip">
    <section class="users-hero animate__animated animate__fadeIn">
        <div class="hero-inner">
            <div>
                <div class="hero-badge">
                    <i class="fas fa-users-gear text-info"></i>
                    EDUTECH AI Admin Center
                </div>

                <h1 class="hero-title">
                    Quản lý <span>người dùng</span>
                </h1>

                <p class="hero-desc">
                    Theo dõi tài khoản, phân quyền Admin, Teacher, Student và quản lý người dùng trong hệ thống.
                </p>
            </div>

            <div class="hero-stat">
                <div class="num">@totalUsers</div>
                <div class="small fw-bold text-white-50 mt-2">Người dùng</div>
            </div>
        </div>
    </section>

    <div class="toolbar-vip">
        <div class="row g-3 align-items-center">
            <div class="col-lg-8">
                <div class="search-box">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="text"
                           id="searchUser"
                           class="form-control"
                           placeholder="Tìm theo username hoặc email..." />
                </div>
            </div>

            <div class="col-lg-4 text-lg-end">
                <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 fw-bold">
                    <i class="fas fa-user-shield me-1"></i>
                    @totalUsers tài khoản
                </span>
            </div>
        </div>
    </div>

    <div class="users-panel">
        @if (!users.Any())
        {
            <div class="empty-state-vip">
                <div class="empty-icon">
                    <i class="fas fa-users"></i>
                </div>

                <h4 class="fw-black text-dark">Chưa có người dùng nào</h4>
                <p class="text-muted mb-0">Danh sách người dùng hiện đang trống.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table users-table align-middle">
                    <thead>
                        <tr>
                            <th>Người dùng</th>
                            <th>Phân quyền</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody id="userTableBody">
                        @foreach (var user in users)
                        {
                            var displayName = user.FullName ?? user.UserName ?? "User";
                            var initial = displayName.Substring(0, 1).ToUpper();

                            var isAdmin = await _userManager.IsInRoleAsync(user, "Admin");
                            var isTeacher = await _userManager.IsInRoleAsync(user, "Teacher");
                            var isStudent = await _userManager.IsInRoleAsync(user, "Student");

                            var currentRole = isAdmin ? "Admin" : isTeacher ? "Teacher" : "Student";

                            <tr class="user-row">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="user-avatar">@initial</div>

                                        <div>
                                            <div class="user-name searchable-user">@displayName</div>
                                            <div class="user-email searchable-email">@user.Email</div>
                                            <span class="role-badge-preview">
                                                <i class="fas fa-shield-halved"></i>@currentRole
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <form asp-action="ChangeRole"
                                          method="post"
                                          class="d-flex gap-2 align-items-center role-form">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="userId" value="@user.Id" />

                                        <select name="newRole" class="form-select form-select-sm role-select">
                                            <option value="Admin" selected="@(isAdmin ? "selected" : null)">Admin</option>
                                            <option value="Teacher" selected="@(isTeacher ? "selected" : null)">Teacher</option>
                                            <option value="Student" selected="@(isStudent ? "selected" : null)">Student</option>
                                        </select>

                                        <button type="submit" class="btn btn-sm btn-outline-primary btn-save-role">
                                            <i class="fas fa-floppy-disk me-1"></i>Lưu
                                        </button>
                                    </form>
                                </td>

                                <td class="text-center">
@{
                                        bool isAdminAcc = await _userManager.IsInRoleAsync(user, "Admin");
                                        bool isSelfAcc  = user.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                    }
                                    @if (isAdminAcc || isSelfAcc)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-secondary btn-delete-user"
                                                disabled
                                                title="@(isSelfAcc ? "Không thể tự xóa tài khoản của mình" : "Không thể xóa tài khoản Admin")">
                                            <i class="fas fa-shield-alt me-1"></i>@(isAdminAcc ? "Admin" : "Bạn")
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="DeleteUser"
                                              method="post"
                                              onsubmit="return confirm('Xóa @user.UserName? Thao tác không thể hoàn tác!');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger btn-delete-user">
                                                <i class="fas fa-trash me-1"></i>Xóa
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchUser')?.addEventListener('input', function () {
            const kw = this.value.toLowerCase().trim();

            document.querySelectorAll('.user-row').forEach(row => {
                const username = row.querySelector('.searchable-user')?.textContent.toLowerCase() || '';
                const email = row.querySelector('.searchable-email')?.textContent.toLowerCase() || '';

                row.style.display = username.includes(kw) || email.includes(kw) ? '' : 'none';
            });
        });
    </script>
}