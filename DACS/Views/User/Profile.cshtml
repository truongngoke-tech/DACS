@using Microsoft.AspNetCore.Identity
@using DACS.Models
@inject UserManager<ApplicationUser> UserManager
@model DACS.Models.ApplicationUser

@{
    ViewData["Title"] = "Hồ sơ của tôi";

    var roles = await UserManager.GetRolesAsync(Model);
    var displayRole = roles.FirstOrDefault() ?? "Student";

    int soBai = ViewBag.SoBai ?? 0;
    double diemTB = ViewBag.DiemTB ?? 0.0;
    double diemCao = ViewBag.DiemCao ?? 0.0;
    int soBookmark = ViewBag.SoBookmark ?? 0;

    string avatarUrl = Model.AvatarUrl ?? "";
    bool hasAvatar = !string.IsNullOrEmpty(avatarUrl);
    string initials = ((!string.IsNullOrEmpty(Model.FullName) ? Model.FullName : Model.UserName) ?? "U")
        .Substring(0, 1)
        .ToUpper();

    string displayName = Model.FullName ?? Model.UserName ?? "Người dùng";
}

<style>
    .profile-vip {
        position: relative;
        max-width: 1180px;
        margin: 0 auto;
        padding: 8px 0 32px;
    }

        .profile-vip::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 12% 8%, rgba(99,102,241,.24), transparent 28%), radial-gradient(circle at 88% 12%, rgba(34,211,238,.22), transparent 30%), radial-gradient(circle at 50% 100%, rgba(236,72,153,.13), transparent 34%);
            z-index: -1;
        }

    .vip-alert {
        border: 0;
        border-radius: 22px;
        box-shadow: 0 18px 45px rgba(15,23,42,.08);
    }

    .profile-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        min-height: 360px;
        padding: 34px;
        color: white;
        background: linear-gradient(135deg, rgba(15,23,42,.96), rgba(30,41,59,.92)), radial-gradient(circle at 18% 20%, rgba(99,102,241,.85), transparent 34%), radial-gradient(circle at 85% 20%, rgba(34,211,238,.65), transparent 36%), radial-gradient(circle at 60% 95%, rgba(236,72,153,.45), transparent 38%);
        box-shadow: 0 34px 90px rgba(15,23,42,.28);
        border: 1px solid rgba(255,255,255,.14);
    }

        .profile-hero::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,.18), transparent);
            transform: translateX(-100%);
            animation: vipShine 5.5s infinite;
        }

    @@keyframes vipShine {
        0% {
            transform: translateX(-100%);
        }

        45%, 100% {
            transform: translateX(100%);
        }
    }

    .profile-hero::after {
        content: "";
        position: absolute;
        width: 340px;
        height: 340px;
        right: -90px;
        bottom: -110px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(99,102,241,.75), rgba(34,211,238,.7), rgba(236,72,153,.55));
        filter: blur(4px);
        opacity: .72;
    }

    .hero-layer {
        position: relative;
        z-index: 2;
    }

    .vip-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(16px);
        color: #e0f2fe;
        font-weight: 800;
        font-size: .82rem;
    }

    .profile-avatar-wrap {
        position: relative;
        width: 148px;
        height: 148px;
        flex-shrink: 0;
    }

    .profile-avatar-ring {
        position: absolute;
        inset: -5px;
        border-radius: 50%;
        background: conic-gradient(from 180deg, #22d3ee, #6366f1, #ec4899, #f59e0b, #22d3ee);
        animation: spinRing 5s linear infinite;
        box-shadow: 0 0 45px rgba(34,211,238,.35);
    }

    @@keyframes spinRing {
        to {
            transform: rotate(360deg);
        }
    }

    .profile-avatar,
    .profile-initial {
        position: absolute;
        inset: 5px;
        width: 138px;
        height: 138px;
        border-radius: 50%;
        object-fit: cover;
        border: 6px solid rgba(15,23,42,.88);
        background: #0f172a;
    }

    .profile-initial {
        display: grid;
        place-items: center;
        color: white;
        font-size: 4rem;
        font-weight: 950;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
    }

    .avatar-camera {
        position: absolute;
        right: 6px;
        bottom: 8px;
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 50%;
        color: #0f172a;
        background: white;
        display: grid;
        place-items: center;
        box-shadow: 0 16px 35px rgba(0,0,0,.25);
        transition: .2s;
        z-index: 4;
    }

        .avatar-camera:hover {
            transform: scale(1.08);
            color: #4f46e5;
        }

    .profile-name {
        font-size: clamp(2rem, 4vw, 4.2rem);
        line-height: .95;
        font-weight: 950;
        letter-spacing: -2px;
        margin: 16px 0 12px;
    }

    .profile-sub {
        color: #cbd5e1;
        max-width: 680px;
        font-size: 1rem;
    }

    .role-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 999px;
        color: white;
        font-weight: 850;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
    }

    .hero-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .btn-vip-main,
    .btn-vip-ghost {
        border-radius: 999px;
        padding: 12px 20px;
        font-weight: 850;
        text-decoration: none;
        border: 0;
        transition: .23s;
    }

    .btn-vip-main {
        color: #0f172a;
        background: linear-gradient(135deg, #ffffff, #dbeafe);
        box-shadow: 0 16px 34px rgba(255,255,255,.16);
    }

        .btn-vip-main:hover {
            color: #4338ca;
            transform: translateY(-3px);
        }

    .btn-vip-ghost {
        color: white;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.18);
    }

        .btn-vip-ghost:hover {
            color: white;
            background: rgba(255,255,255,.16);
            transform: translateY(-3px);
        }

    .stats-grid {
        margin-top: -56px;
        position: relative;
        z-index: 5;
    }

    .stat-vip {
        position: relative;
        overflow: hidden;
        height: 100%;
        border-radius: 28px;
        border: 1px solid rgba(255,255,255,.7);
        background: rgba(255,255,255,.88);
        backdrop-filter: blur(18px);
        padding: 24px;
        box-shadow: 0 22px 55px rgba(15,23,42,.10);
        transition: .25s;
    }

        .stat-vip:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 76px rgba(15,23,42,.16);
        }

        .stat-vip::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -58px;
            top: -58px;
            border-radius: 50%;
            background: var(--glow);
            opacity: .17;
        }

    .stat-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        display: grid;
        place-items: center;
        color: white;
        font-size: 24px;
        background: var(--grad);
        box-shadow: 0 15px 30px var(--shadow);
        margin-bottom: 15px;
    }

    .stat-num {
        font-size: 2.25rem;
        font-weight: 950;
        line-height: 1;
        color: #0f172a;
        letter-spacing: -1px;
    }

    .stat-label {
        color: #64748b;
        font-size: .88rem;
        font-weight: 700;
        margin-top: 8px;
    }

    .info-panel {
        margin-top: 28px;
        border-radius: 32px;
        border: 1px solid rgba(255,255,255,.72);
        background: rgba(255,255,255,.86);
        backdrop-filter: blur(18px);
        box-shadow: 0 24px 64px rgba(15,23,42,.10);
        overflow: hidden;
    }

    .panel-head {
        padding: 24px 28px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
    }

    .panel-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.35rem;
        font-weight: 950;
    }

    .panel-body {
        padding: 28px;
    }

    .info-tile {
        height: 100%;
        border-radius: 24px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 20px;
    }

    .info-label {
        color: #64748b;
        font-size: .78rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 8px;
    }

    .info-value {
        color: #0f172a;
        font-weight: 850;
        word-break: break-word;
    }

    .action-zone {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
    }

    .action-btn {
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 850;
        text-decoration: none;
        transition: .22s;
    }

        .action-btn:hover {
            transform: translateY(-3px);
        }

    .learning-card {
        height: 100%;
        border-radius: 28px;
        padding: 24px;
        color: white;
        overflow: hidden;
        position: relative;
        background: linear-gradient(135deg, #4f46e5, #06b6d4);
        box-shadow: 0 24px 60px rgba(79,70,229,.22);
    }

        .learning-card::after {
            content: "✦";
            position: absolute;
            right: 24px;
            top: 16px;
            font-size: 70px;
            opacity: .16;
        }

    .progress-vip {
        height: 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.2);
        overflow: hidden;
        margin-top: 16px;
    }

        .progress-vip span {
            display: block;
            height: 100%;
            width: @(Math.Min(100, Math.Max(0, diemTB * 10)).ToString("F0")) %;
            border-radius: 999px;
            background: white;
        }

    .backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.62);
        backdrop-filter: blur(6px);
        z-index: 1040;
    }

    .mymodal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1050;
        align-items: center;
        justify-content: center;
        padding: 18px;
        overflow-y: auto;
    }

        .mymodal.open {
            display: flex;
        }

        .mymodal .box {
            width: 100%;
            max-width: 500px;
            border-radius: 30px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(255,255,255,.8);
            box-shadow: 0 34px 95px rgba(15,23,42,.32);
            animation: popIn .22s ease;
            overflow: hidden;
        }

    @@keyframes popIn {
        from {
            opacity: 0;
            transform: scale(.94) translateY(12px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .mymodal .box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 26px 0;
    }

    .mymodal .box-body {
        padding: 22px 26px;
    }

    .mymodal .box-footer {
        padding: 0 26px 26px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .vip-input {
        border-radius: 999px;
        padding: 12px 18px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        font-weight: 700;
    }

        .vip-input:focus {
            box-shadow: 0 0 0 .25rem rgba(99,102,241,.15);
            border-color: #6366f1;
        }

    .drop-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 26px;
        padding: 32px 18px;
        text-align: center;
        cursor: pointer;
        transition: .22s;
        background: linear-gradient(135deg, #f8fafc, #eef2ff);
    }

        .drop-zone:hover,
        .drop-zone.dragover {
            border-color: #6366f1;
            background: linear-gradient(135deg, #eef2ff, #ecfeff);
            transform: translateY(-2px);
        }

        .drop-zone img,
        .drop-zone .ini {
            width: 104px;
            height: 104px;
            object-fit: cover;
            border-radius: 50%;
            box-shadow: 0 16px 35px rgba(15,23,42,.16);
        }

        .drop-zone .ini {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #4f46e5, #06b6d4);
            color: white;
            font-size: 2.6rem;
            font-weight: 950;
            margin-bottom: 12px;
        }

    @@media (max-width: 768px) {
        .profile-hero {
            padding: 26px;
        }

        .profile-main {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .stats-grid {
            margin-top: 22px;
        }

        .panel-head {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="profile-vip">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show vip-alert mb-4">
            <i class="fas fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show vip-alert mb-4">
            <i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <section class="profile-hero animate__animated animate__fadeIn">
        <div class="hero-layer">
            <div class="d-flex align-items-center gap-4 profile-main">
                <div class="profile-avatar-wrap">
                    <div class="profile-avatar-ring"></div>

                    @if (hasAvatar)
                    {
                        <img src="@avatarUrl" class="profile-avatar" />
                    }
                    else
                    {
                        <div class="profile-initial">@initials</div>
                    }

                    <button type="button" onclick="openModal('avatarModal')" class="avatar-camera" title="Đổi ảnh">
                        <i class="fas fa-camera"></i>
                    </button>
                </div>

                <div>
                    <div class="vip-badge">
                        <i class="fas fa-crown text-warning"></i>
                        Hồ sơ học viên 
                    </div>

                    <h1 class="profile-name">@displayName</h1>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="role-pill">
                            <i class="fas fa-shield-halved text-info"></i>
                            @displayRole
                        </span>
                        <span class="role-pill">
                            <i class="fas fa-sparkles text-warning"></i>
                            EDUTECH AI Member
                        </span>
                    </div>

                    <p class="profile-sub mt-3 mb-0">
                        Theo dõi thành tích, chỉnh sửa thông tin cá nhân, quản lý đề đã lưu và tiếp tục hành trình chinh phục kiến thức.
                    </p>

                    <div class="hero-actions">
                        <button type="button" class="btn-vip-main" onclick="openModal('editModal')">
                            <i class="fas fa-pen-to-square me-2"></i>Chỉnh sửa hồ sơ
                        </button>
                        <a href="/Exam/History" class="btn-vip-ghost">
                            <i class="fas fa-clock-rotate-left me-2"></i>Xem lịch sử thi
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-4 stats-grid">
        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#4f46e5,#06b6d4);--shadow:rgba(79,70,229,.28);--glow:#4f46e5;">
                <div class="stat-icon">
                    <i class="fas fa-book-open"></i>
                </div>
                <div class="stat-num">@soBai</div>
                <div class="stat-label">Bài đã làm</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#16a34a,#22c55e);--shadow:rgba(34,197,94,.28);--glow:#22c55e;">
                <div class="stat-icon">
                    <i class="fas fa-star"></i>
                </div>
                <div class="stat-num">@diemTB.ToString("F1")</div>
                <div class="stat-label">Điểm trung bình</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#f59e0b,#f97316);--shadow:rgba(249,115,22,.28);--glow:#f59e0b;">
                <div class="stat-icon">
                    <i class="fas fa-trophy"></i>
                </div>
                <div class="stat-num">@diemCao.ToString("F1")</div>
                <div class="stat-label">Điểm cao nhất</div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="stat-vip"
                 style="--grad:linear-gradient(135deg,#db2777,#ec4899);--shadow:rgba(236,72,153,.28);--glow:#ec4899;">
                <div class="stat-icon">
                    <i class="fas fa-bookmark"></i>
                </div>
                <div class="stat-num">@soBookmark</div>
                <div class="stat-label">Đề đã lưu</div>
            </div>
        </div>
    </div>

    <div class="info-panel">
        <div class="panel-head">
            <div>
                <h3 class="panel-title">Thông tin cá nhân</h3>
                <div class="text-muted fw-semibold small mt-1">Quản lý dữ liệu tài khoản và hành trình học tập</div>
            </div>

            <button type="button" class="btn btn-dark rounded-pill px-4 fw-bold" onclick="openModal('editModal')">
                <i class="fas fa-edit me-2"></i>Cập nhật
            </button>
        </div>

        <div class="panel-body">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-tile">
                                <div class="info-label">
                                    <i class="fas fa-envelope me-1"></i>Email
                                </div>
                                <div class="info-value">@(Model.Email ?? "—")</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-tile">
                                <div class="info-label">
                                    <i class="fas fa-phone me-1"></i>Số điện thoại
                                </div>
                                <div class="info-value">@(Model.PhoneNumber ?? "Chưa cập nhật")</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-tile">
                                <div class="info-label">
                                    <i class="fas fa-user me-1"></i>Tên hiển thị
                                </div>
                                <div class="info-value">@displayName</div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-tile">
                                <div class="info-label">
                                    <i class="fas fa-user-shield me-1"></i>Vai trò
                                </div>
                                <div class="info-value">@displayRole</div>
                            </div>
                        </div>
                    </div>

                    <div class="action-zone">
                        <a href="/Exam/YeuThich" class="btn btn-outline-warning action-btn">
                            <i class="fas fa-bookmark me-2"></i>Đề đã lưu
                        </a>
                        <a href="/Exam/SoTayCauSai" class="btn btn-outline-danger action-btn">
                            <i class="fas fa-book me-2"></i>Sổ tay câu sai
                        </a>
                        <a href="/Exam/History" class="btn btn-outline-secondary action-btn">
                            <i class="fas fa-history me-2"></i>Lịch sử thi
                        </a>
                        <a href="/User/DoiMatKhau" class="btn btn-outline-dark action-btn">
                            <i class="fas fa-key me-2"></i>Đổi mật khẩu
                        </a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="learning-card">
                        <div class="fw-black fs-5 mb-2">
                            <i class="fas fa-brain me-2"></i>Năng lực học tập
                        </div>
                        <div class="small opacity-75">
                            Dựa trên điểm trung bình hiện tại của bạn.
                        </div>

                        <div class="display-5 fw-black mt-3">@diemTB.ToString("F1")/10</div>

                        <div class="progress-vip">
                            <span></span>
                        </div>

                        <div class="small mt-3 opacity-75">
                            @(diemTB >= 8 ? "Xuất sắc! Tiếp tục giữ phong độ."
                                : diemTB >= 5 ? "Ổn rồi! Hãy luyện thêm để bứt phá."
                                : "Cần cố gắng hơn. AI sẽ giúp bạn cải thiện.")
                        </div>

                        <a href="/AI/Roadmap" class="btn btn-light rounded-pill fw-bold px-4 mt-4">
                            <i class="fas fa-route me-2"></i>Xem lộ trình
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="backdrop" id="backdrop" onclick="closeModal()"></div>

<div class="mymodal" id="editModal">
    <div class="box">
        <div class="box-header">
            <h5 class="fw-black m-0">
                <i class="fas fa-pen-to-square me-2 text-primary"></i>Chỉnh sửa hồ sơ
            </h5>
            <button type="button" class="btn-close" onclick="closeModal()"></button>
        </div>

        <form asp-action="UpdateProfile" asp-controller="User" method="post">
            @Html.AntiForgeryToken()

            <div class="box-body">
                <div class="mb-3">
                    <label class="form-label fw-bold small">Họ và tên</label>
                    <input type="text"
                           name="fullName"
                           class="form-control vip-input"
                           value="@(Model.FullName ?? "")"
                           placeholder="Nhập họ tên..."
                           required />
                </div>

                <div>
                    <label class="form-label fw-bold small">Số điện thoại</label>
                    <input type="tel"
                           name="phoneNumber"
                           class="form-control vip-input"
                           value="@(Model.PhoneNumber ?? "")"
                           placeholder="Nhập số điện thoại..." />
                </div>
            </div>

            <div class="box-footer flex-row justify-content-end gap-2">
                <button type="button" class="btn btn-light rounded-pill px-4" onclick="closeModal()">Hủy</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="fas fa-floppy-disk me-2"></i>Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

<div class="mymodal" id="avatarModal">
    <div class="box">
        <div class="box-header">
            <h5 class="fw-black m-0">
                <i class="fas fa-camera me-2 text-primary"></i>Đổi ảnh đại diện
            </h5>
            <button type="button" class="btn-close" onclick="closeModal()"></button>
        </div>

        <form id="frmUpload"
              asp-action="UploadAvatar"
              asp-controller="User"
              method="post"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="box-body">
                <div class="drop-zone" id="dropZone" onclick="document.getElementById('fileAvatar').click()">
                    @if (hasAvatar)
                    {
                        <img id="avatarPreview" src="@avatarUrl" class="mb-3" />
                    }
                    else
                    {
                        <div class="ini" id="avatarPreview">@initials</div>
                    }

                    <div class="text-muted small fw-bold" id="dropLabel">
                        <i class="fas fa-cloud-arrow-up me-1"></i>Click hoặc kéo thả ảnh vào đây
                    </div>

                    <div class="text-muted mt-2" style="font-size:.74rem;">
                        JPG, PNG, GIF, WebP — tối đa 2MB
                    </div>

                    <input type="file"
                           id="fileAvatar"
                           name="avatarFile"
                           accept="image/jpeg,image/png,image/gif,image/webp"
                           style="display:none" />
                </div>
            </div>

            <div class="box-footer">
                <button type="submit"
                        id="btnUpload"
                        class="btn btn-primary rounded-pill w-100 fw-bold"
                        disabled>
                    <i class="fas fa-upload me-2"></i>Tải lên ảnh đã chọn
                </button>

                @if (hasAvatar)
                {
                    <button type="button"
                            class="btn btn-outline-danger rounded-pill w-100"
                            onclick="if(confirm('Xóa ảnh đại diện hiện tại?')) document.getElementById('frmXoa').submit()">
                        <i class="fas fa-trash me-2"></i>Xóa ảnh hiện tại
                    </button>
                }

                <button type="button" class="btn btn-light rounded-pill w-100" onclick="closeModal()">Hủy</button>
            </div>
        </form>
    </div>
</div>

<form id="frmXoa" asp-action="XoaAvatar" asp-controller="User" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        let currentModal = null;

        function openModal(id) {
            if (currentModal) currentModal.classList.remove('open');

            currentModal = document.getElementById(id);
            currentModal.classList.add('open');

            document.getElementById('backdrop').style.display = 'block';
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            if (currentModal) currentModal.classList.remove('open');

            currentModal = null;
            document.getElementById('backdrop').style.display = 'none';
            document.body.style.overflow = '';

            const fi = document.getElementById('fileAvatar');
            if (fi) fi.value = '';

            const lbl = document.getElementById('dropLabel');
            if (lbl) {
                lbl.innerHTML = '<i class="fas fa-cloud-arrow-up me-1"></i>Click hoặc kéo thả ảnh vào đây';
            }

            const btn = document.getElementById('btnUpload');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-upload me-2"></i>Tải lên ảnh đã chọn';
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeModal();
        });

        const fileAvatar = document.getElementById('fileAvatar');

        fileAvatar.addEventListener('change', function () {
            const file = this.files[0];

            if (!file) return;

            if (file.size > 2 * 1024 * 1024) {
                alert('Ảnh vượt quá 2MB!');
                this.value = '';
                return;
            }

            if (!file.type.startsWith('image/')) {
                alert('File không hợp lệ!');
                this.value = '';
                return;
            }

            const reader = new FileReader();

            reader.onload = function(ev) {
                const prev = document.getElementById('avatarPreview');

                if (prev.tagName === 'IMG') {
                    prev.src = ev.target.result;
                } else {
                    const img = document.createElement('img');
                    img.id = 'avatarPreview';
                    img.src = ev.target.result;
                    img.className = 'mb-3';
                    img.style.cssText = 'width:104px;height:104px;object-fit:cover;border-radius:50%;box-shadow:0 16px 35px rgba(15,23,42,.16);';
                    prev.replaceWith(img);
                }
            };

            reader.readAsDataURL(file);

            document.getElementById('dropLabel').innerHTML =
                '<i class="fas fa-circle-check text-success me-1"></i>' + file.name;

            const btn = document.getElementById('btnUpload');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-upload me-2"></i>Tải lên: ' + file.name;
        });

        const dz = document.getElementById('dropZone');

        dz.addEventListener('dragover', function(e) {
            e.preventDefault();
            dz.classList.add('dragover');
        });

        dz.addEventListener('dragleave', function() {
            dz.classList.remove('dragover');
        });

        dz.addEventListener('drop', function(e) {
            e.preventDefault();
            dz.classList.remove('dragover');

            const file = e.dataTransfer.files[0];

            if (file && file.type.startsWith('image/')) {
                const dt = new DataTransfer();
                dt.items.add(file);

                document.getElementById('fileAvatar').files = dt.files;
                document.getElementById('fileAvatar').dispatchEvent(new Event('change'));
            }
        });
    </script>
}